---
interface Props {
  name: "arrow-up-right" | "arrow-right" | "plus" | "gem" | "mail" | "repository" | "conversation";
  class?: string;
}
const { name, class: className = "" } = Astro.props;
---
<svg class={`icon ${className}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href={`/icons.svg#${name}`} /></svg>
