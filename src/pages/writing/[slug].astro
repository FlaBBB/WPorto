---
/**
 * The writeup itself.
 *
 * The page keeps what the site can hold honestly: the event, the result, and
 * each challenge's approach, with the full post linked per challenge for the
 * screenshots, tool output and source listings. It is the `document` variant of
 * the Portfolio layout, so the header and footer stay the same while the
 * opening and its scroll scene stay on the home page.
 */
import SparseStars from "../../components/SparseStars.svelte";
import Portfolio from "../../layouts/Portfolio.astro";
import { WRITING, padIndex, writingProfile } from "../../lib/writing";

export function getStaticPaths() {
  return WRITING.map((writeup) => ({
    params: { slug: writeup.slug },
    props: { writeup },
  }));
}

const { writeup } = Astro.props;
---

<Portfolio
  title={`${writeup.title} — Fikri Muhammad Abdillah`}
  metaDescription={writeup.deck}
  path={`/writing/${writeup.slug}`}
  variant="document"
  ogType="article"
>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <div class="article-page">
    <SparseStars seed={9} client:load />
    <article class="article-shell" aria-labelledby="article-heading">
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href="/writing">Writing</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{writeup.event}</span>
      </nav>

      <header class="article-hero">
        <p class="eyebrow">
          <time datetime={writeup.date}>{writeup.dateLabel}</time>
          <span aria-hidden="true"> · </span>
          Reverse engineering
        </p>
        <h1 id="article-heading">{writeup.title}</h1>
        <p class="article-deck">{writeup.deck}</p>
        <dl class="challenge-meta">
          <div>
            <dt>Event</dt>
            <dd>{writeup.event}</dd>
          </div>
          <div>
            <dt>Result</dt>
            <dd>{writeup.result}</dd>
          </div>
          <div>
            <dt>Contribution</dt>
            <dd>{writeup.contribution}</dd>
          </div>
        </dl>
      </header>

      <!--
        The article's own opening image. It is framed rather than full-bleed, so
        an image with a light background reads as a plate on the page instead of
        a hole punched in it; the frame's tone is set from the image itself.
      -->
      <figure class="article-figure article-cover" data-tone="dark">
        <img
          src={writeup.cover.src}
          alt={writeup.cover.alt}
          width="1324"
          height="660"
          loading="eager"
          decoding="async"
        />
        <figcaption>{writeup.cover.caption}</figcaption>
      </figure>

      <div class="article-body">
        <p>
          TCP1P International 2024 ran for two days in October, and I played it
          with team Serikat Newbie Indonesia. We finished 10th overall and 4th
          among Indonesian teams; my part was five reverse-engineering
          challenges. They are collected here in the order the writeup presents
          them — cheapest first — because that order is also the story: each one
          asks for a different kind of attention, and the last one asks for all
          of them at once.
        </p>

        <h2>The five solves</h2>
        <ol class="challenge-list">
          {writeup.challenges.map((challenge, index) => (
            <li class="challenge" id={challenge.slug} data-reveal>
              <div class="challenge-head">
                <span class="challenge-index" aria-hidden="true">{padIndex(index)}</span>
                <h3>{challenge.name}</h3>
                <span class="challenge-points">{challenge.points}</span>
              </div>
              <p class="challenge-deck">{challenge.deck}</p>
              <p class="challenge-approach">{challenge.approach}</p>
              {challenge.images?.map((image) => (
                <figure class="article-figure" data-tone="dark">
                  <img
                    src={image.src}
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{image.caption}</figcaption>
                </figure>
              ))}
              <a class="text-link" href={challenge.href}>
                Full writeup for {challenge.name} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>

        <h2>What the set has in common</h2>
        <p>
          None of these are broken by a single trick. Each one is broken by
          noticing that a tool is telling you a smaller story than the binary is:
          a decompiler that stops at the first return, a virtual machine standing
          between you and the code, an exception handler that only runs when the
          program is already failing. The work is to find the layer the tool
          leaves out, then read it on its own terms.
        </p>
        <p>
          The full posts keep the screenshots and the solver listings, which is
          why each challenge links out to Medium rather than being reproduced
          here.
        </p>
      </div>

      <footer class="article-footer">
        <p class="article-source">
          Originally published on Medium, {writeup.dateLabel}.
        </p>
        <a class="text-link" href={writeup.href}>
          Read the original post <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={writingProfile}>
          More writing on Medium <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/writing">
          All writing <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </article>
  </div>
</Portfolio>

<script>
  import { toneOf } from "../../lib/imageTone";

  /*
    Every figure declares its tone from the image itself.

    A writeup's images come from wherever the challenge did: tool windows are
    usually light, terminals are usually dark. The page cannot know which until
    the pixels are there, so each image is sampled once at its own small size and
    the figure is marked `light` or `dark`. The stylesheet then decides how much
    the frame has to hold it: a light plate gets a hairline inside its edge and a
    softer lift, so it sits on the page rather than glaring off it. Sampling is
    same-origin, so the canvas is never tainted; if it fails, the default stands.
  */
  const TONE_SIZE = 24;
  for (const figure of document.querySelectorAll<HTMLElement>(".article-figure")) {
    const image = figure.querySelector("img");
    if (!image) continue;
    const sample = () => {
      const canvas = document.createElement("canvas");
      canvas.width = TONE_SIZE;
      canvas.height = TONE_SIZE;
      const context = canvas.getContext("2d", { willReadFrequently: true });
      if (!context) return;
      context.drawImage(image, 0, 0, TONE_SIZE, TONE_SIZE);
      const { data } = context.getImageData(0, 0, TONE_SIZE, TONE_SIZE);
      figure.dataset.tone = toneOf(data);
    };
    if (image.complete && image.naturalWidth) sample();
    else image.addEventListener("load", sample, { once: true });
  }

  /*
    The progress line is a reading aid: it follows the article's position in the
    document and is written on the next frame. There is no transition to remove
    under reduced motion; the line simply tracks position.
  */
  const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
  const article = document.querySelector<HTMLElement>(".article-shell");
  if (bar && article) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const box = article.getBoundingClientRect();
      const start = box.top + window.scrollY;
      const distance = Math.max(1, box.height - window.innerHeight * 0.4);
      const progress = Math.min(
        1,
        Math.max(0, (window.scrollY - start + window.innerHeight * 0.25) / distance),
      );
      bar.style.transform = `scaleX(${progress.toFixed(4)})`;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();
  }
</script>
