---
/**
 * The Writing index: the published writeup, and the challenges inside it.
 *
 * It is a document rather than a home section, so it uses the same shell with
 * the `document` variant: section links return to the Portfolio Site's anchors,
 * and Writing itself is the current page.
 */
import SparseStars from "../../components/SparseStars.svelte";
import Portfolio from "../../layouts/Portfolio.astro";
import { WRITING, padIndex, writingProfile } from "../../lib/writing";

const latest = WRITING[0];
---

<Portfolio
  title="Writing — Fikri Muhammad Abdillah"
  metaDescription="Reverse-engineering writeups by Fikri Muhammad Abdillah: the TCP1P International 2024 challenges, solved and written up."
  path="/writing"
  variant="document"
>
  <div class="writing-page">
    <SparseStars seed={8} client:load />
    <div class="writing-page-inner">
      <header class="writing-index-hero">
        <p class="eyebrow">Writing</p>
        <h1>Writeups, kept in the open.</h1>
        <p class="writing-index-intro">
          Reverse-engineering challenges, written up while they were still fresh:
          how each binary was read, what the tools hid, and how the flag came out.
        </p>
        <p class="writing-index-count">
          {WRITING.length} writeup{WRITING.length === 1 ? "" : "s"} · last published {latest?.dateLabel}
        </p>
      </header>

      <section class="writing-index-list" aria-labelledby="writing-index-heading">
        <h2 id="writing-index-heading" class="visually-hidden">Published writeups</h2>
        <a class="writing-index-feature" href={`/writing/${latest.slug}`}>
          <span class="writing-index-thumb" aria-hidden="true">
            <img src={latest.image} alt="" width="1600" height="1067" loading="lazy" decoding="async" />
          </span>
          <span class="writing-index-feature-body">
            <span class="writing-feature-meta">
              <time datetime={latest.date}>{latest.dateLabel}</time>
              <span aria-hidden="true">·</span>
              <span>{latest.event}</span>
            </span>
            <span class="writing-feature-title">{latest.title}</span>
            <span class="writing-feature-deck">{latest.deck}</span>
            <span class="writing-result">
              <span>{latest.result}</span>
              <span aria-hidden="true">·</span>
              <span>{latest.contribution}</span>
            </span>
          </span>
        </a>

        <div class="writing-index-contents">
          <h2>Inside</h2>
          <ol class="writing-chapters">
            {latest.challenges.map((challenge, index) => (
              <li data-reveal data-enter="right" data-enter-delay={(index * 0.05).toFixed(2)}>
                <a class="writing-chapter" href={`/writing/${latest.slug}#${challenge.slug}`}>
                  <span class="writing-chapter-index" aria-hidden="true">{padIndex(index)}</span>
                  <span class="writing-chapter-body">
                    <span class="writing-chapter-name">{challenge.name}</span>
                    <span class="writing-chapter-deck">{challenge.deck}</span>
                  </span>
                  <span class="writing-chapter-meta">{challenge.points}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <p class="writing-index-profile">
        More on <a href={writingProfile}>Medium <span aria-hidden="true">↗</span></a>
      </p>
    </div>
  </div>
</Portfolio>
