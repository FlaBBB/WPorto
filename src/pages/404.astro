---
import { FLAB_PATH, FLAB_FILL_RULE, FLAB_VIEWBOX } from "../lib/flabMark";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#17131e" />
    <title>Page not found — Fikri Muhammad Abdillah</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <a class="flab-logo" href="/" aria-label="flab — back to the Portfolio Site">
        <svg viewBox={`0 0 ${FLAB_VIEWBOX.width} ${FLAB_VIEWBOX.height}`} aria-hidden="true">
          <path d={FLAB_PATH} fill="currentColor" fill-rule={FLAB_FILL_RULE} />
        </svg>
      </a>
      <p class="eyebrow">404</p>
      <h1>Nothing here after hours.</h1>
      <p>This page doesn’t exist. The Portfolio Site is one page — the work is still there.</p>
      <a class="return-link" href="/">Back to the Portfolio Site <span aria-hidden="true">↗</span></a>
    </main>
    <style>
      :global(html) {
        color-scheme: dark;
        background: #17131e;
      }
      :global(body) {
        margin: 0;
        color: #ece8f4;
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue",
          Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      main {
        max-width: 46rem;
        margin-inline: auto;
        padding: clamp(3rem, 12vh, 8rem) clamp(1.25rem, 5vw, 5rem);
      }
      .flab-logo {
        display: inline-flex;
        color: #ece8f4;
      }
      .flab-logo svg {
        width: 4.5rem;
        height: auto;
        display: block;
      }
      .eyebrow {
        margin-top: 2.5rem;
        color: #a89fb8;
        font: 500 0.75rem/1.5 ui-monospace, monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      h1 {
        margin: 1rem 0 1.25rem;
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        line-height: 1.02;
        letter-spacing: -0.045em;
      }
      p:not(.eyebrow) {
        max-width: 42ch;
        color: #a89fb8;
        line-height: 1.6;
      }
      .return-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        margin-top: 2rem;
        color: #d9cffb;
        text-underline-offset: 0.25em;
      }
      .return-link:focus-visible,
      .flab-logo:focus-visible {
        outline: 2px solid #a78bfa;
        outline-offset: 4px;
      }
    </style>
  </body>
</html>
