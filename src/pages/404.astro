---
import Icon from "../components/Icon.astro";
import "../styles/portfolio.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f8f3eb" />
    <title>Page not found — Fikri Flab</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="not-found shell">
      <a class="wordmark" href="/" aria-label="Fikri Flab — home"><img class="brand-mark" src="/favicon.svg" width="48" height="48" alt="" />Fikri Flab</a>
      <div class="not-found-sheet paper">
        <p class="eyebrow">Fikri Flab / 404</p>
        <h1>A little detour.</h1>
        <p>This page doesn’t exist. The Portfolio Site is one page — the work is still there.</p>
        <a class="primary-link paper paper--press" href="/">Back to the Portfolio Site <Icon name="arrow-right" /></a>
      </div>
    </main>
  </body>
</html>
