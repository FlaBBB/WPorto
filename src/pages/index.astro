---
import EvidenceLedger from "../components/EvidenceLedger.svelte";
import FlabSculpture from "../components/FlabSculpture.svelte";
import SectionHeading from "../components/SectionHeading.svelte";
import SparseStars from "../components/SparseStars.svelte";
import { FLAB_PATH, FLAB_FILL_RULE, FLAB_VIEWBOX } from "../lib/flabMark";
import {
  description,
  email,
  githubProfile,
  linkedInProfile,
  ownerName,
  profileRecords,
  projects,
  sections,
} from "../lib/portfolio";
import "../styles/fonts.css";
import "../styles/portfolio.css";

// Recognizable contact marks. They are decorative (aria-hidden); the adjacent
// text labels carry the accessible name.
const GITHUB_ICON =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
const LINKEDIN_ICON =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>flab — Fikri Muhammad Abdillah</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17131e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="flab — Fikri Muhammad Abdillah" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://flab.my.id/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="flab — Fikri Muhammad Abdillah" />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://flab.my.id/" />
    <!--
      The variable sans is the only face above the fold (the wordmark, the opening
      heading), so it is preloaded to avoid a swap on the largest text. Fonts load
      in CORS mode, hence the crossorigin attribute.
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/schibsted-grotesk-var.woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduced = false;
        try {
          reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        } catch (error) {
          reduced = false;
        }
        if (!reduced) root.classList.add("motion");
        window.setTimeout(function () {
          if (!window.__afterHoursMotionReady) root.classList.remove("motion");
        }, 2000);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="flab-logo" href="#identity" aria-label="flab — back to Fikri Muhammad Abdillah’s identity">
        <svg viewBox={`0 0 ${FLAB_VIEWBOX.width} ${FLAB_VIEWBOX.height}`} aria-hidden="true">
          <path d={FLAB_PATH} fill="currentColor" fill-rule={FLAB_FILL_RULE} />
        </svg>
      </a>
    </header>

    <main id="main-content" tabindex="-1">
      <section id="identity" aria-label="Identity">
        <FlabSculpture
          destinations={sections}
          client:media="(prefers-reduced-motion: no-preference)"
        />
      </section>

      <!--
        Each lower section (and the footer) carries its own lightweight local
        sparse-star layer: DOM/CSS rather than another full-page canvas, clipped
        to that section and painted above its background but under its content.
      -->
      <div class="page-body">
        <section id="intro" aria-labelledby="intro-heading">
          <SparseStars seed={1} client:load />
          <div class="intro-layout">
            <div class="intro-lead">
              <h1 id="intro-heading">Fikri Muhammad Abdillah<span class="intro-dot" aria-hidden="true">.</span></h1>
              <p class="intro-secondary">Web applications. Realtime systems.</p>
            </div>
            <div class="intro-body">
              <p class="intro-note" data-reveal>
                Based in Malang, Indonesia, my focus is TypeScript across web and realtime
                applications and agentic workflow tooling, with the public repositories in
                that space open to read.
              </p>
              <p class="intro-note intro-note-soft" data-reveal>
                Capture the flag is where I keep learning — cryptography, digital forensics,
                reverse engineering, binary exploitation and smart-contract security — kept
                as notes rather than presented as professional security work.
              </p>
              <a class="intro-link" href="#selected-evidence" data-reveal>
                Selected work <span aria-hidden="true">↓</span>
              </a>
            </div>
          </div>
        </section>

        <section id="selected-evidence" aria-labelledby="selected-evidence-heading">
          <SparseStars seed={2} client:load />
          <div class="work-layout">
            <div class="work-intro">
              <SectionHeading
                index="01"
                label="Work"
                headingId="selected-evidence-heading"
                title="Look inside the work."
                intro="Three public repositories. Different systems, with the source material open to inspection."
              />
            </div>
            <ol class="work-index">
              {projects.map((project) => (
                <li data-reveal>
                  <article aria-labelledby={`${project.id}-heading`}>
                    <p class="project-index" aria-hidden="true">{project.index}</p>
                    <div class="project-body">
                      <h3 id={`${project.id}-heading`}>{project.name}</h3>
                      <p class="project-deck">{project.deck}</p>
                      <div class="project-structure" aria-label={project.structureLabel}>
                        {project.structure.map((item) => <span>{item}</span>)}
                      </div>
                      <p class="project-copy">{project.copy}</p>
                      <p class="scope-note">{project.scopeNote}</p>
                      <a class="project-link" href={project.href}>Source: {project.name} <span aria-hidden="true">↗</span></a>
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section id="technical-profile" aria-labelledby="technical-profile-heading">
          <SparseStars seed={3} client:load />
          <div class="section-heading">
            <SectionHeading
              index="02"
              label="Profile"
              headingId="technical-profile-heading"
              title="Evidence over claims."
              intro="A curated record of publicly visible projects and learning material. Open a record for the evidence and its limits."
            />
          </div>
          <EvidenceLedger records={profileRecords} />
        </section>

        <section id="learning-archive" aria-labelledby="learning-archive-heading">
          <SparseStars seed={4} client:load />
          <div class="section-heading">
            <SectionHeading
              index="03"
              label="Archive"
              headingId="learning-archive-heading"
              title="Still learning. Keeping the notes."
            />
          </div>
          <div class="archive-layout">
            <p class="archive-statement" data-reveal>
              A public CTF-oriented archive spans cryptography, digital forensics, reverse
              engineering, binary exploitation, and smart-contract security.
            </p>
            <div class="archive-aside">
              <p class="archive-detail" data-reveal>
                Drawn from many competition platforms and paired with supporting tools and
                cheatsheets.
              </p>
              <p class="scope-note" data-reveal>Learning material, not professional security experience.</p>
              <div class="archive-links">
                <a class="text-link" href="https://github.com/FlaBBB/Cybers_security" data-reveal>
                  Inspect Cybers_security <span aria-hidden="true">↗</span>
                </a>
                <a class="text-link" href="https://ctftime.org/user/156246" data-reveal>
                  Competition record on CTFtime <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </section>

        <section id="contact-path" aria-labelledby="contact-path-heading">
          <SparseStars seed={5} tone="plum" client:load />
          <div class="contact-layout">
            <div class="contact-intro-block">
              <SectionHeading
                index="04"
                label="Contact"
                headingId="contact-path-heading"
                title="Let’s talk."
                intro="Explore the source, connect on LinkedIn, or send a note directly."
                introClass="contact-intro"
              />
            </div>
            <ul class="contact-paths">
              <li data-reveal>
                <a href={githubProfile}>
                  <span class="contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d={GITHUB_ICON} /></svg>
                  </span>
                  <span class="contact-label"><strong>GitHub</strong><span>Inspect public work</span></span>
                  <span class="contact-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
              <li data-reveal>
                <a href={linkedInProfile}>
                  <span class="contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d={LINKEDIN_ICON} /></svg>
                  </span>
                  <span class="contact-label"><strong>LinkedIn</strong><span>Professional profile</span></span>
                  <span class="contact-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
              <li data-reveal>
                <!--email_off--><a href={`mailto:${email}`}>
                  <span class="contact-icon contact-icon-envelope" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
                      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
                    </svg>
                  </span>
                  <span class="contact-label"><strong>Email</strong><span>Start a conversation</span></span>
                  <span class="contact-arrow" aria-hidden="true">↗</span>
                </a><!--/email_off-->
              </li>
            </ul>
          </div>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <SparseStars seed={6} client:load />
      <div class="footer-inner">
        <p class="footer-identity">
          <span class="footer-name">{ownerName}</span>
          <span class="footer-sep" aria-hidden="true">·</span>
          <span class="footer-copy">© {year}</span>
        </p>
        <!--
          The right group is the back-to-top link itself, so there is no third
          visible "Back to top" group. Its accessible name keeps the visible
          "Still learning." label (Label in Name) while naming the destination.
        -->
        <a class="footer-top" href="#identity" aria-label="Back to top — Still learning." title="Back to top">
          <span class="footer-note">Still learning.</span>
          <span class="footer-dash" aria-hidden="true"></span>
        </a>
      </div>
      <!--
        The constellation is the opening's navigation, but it is not the only route
        to a section: this static list carries the same four destinations for
        anyone who lands deep in the page, skips the opening, or cannot use the
        stage at all.
      -->
      <nav class="footer-nav" aria-label="Portfolio sections">
        <ul>
          {sections.map(({ id, label }) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </footer>

    

    <script>
      import gsap from "gsap";

      // Foreground tweens follow elapsed time even when a rendering frame is slow.
      gsap.ticker.lagSmoothing(0);

      declare global {
        interface Window {
          __afterHoursMotionReady?: boolean;
        }
      }

      const root = document.documentElement;
      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealTargets = gsap.utils.toArray<HTMLElement>("[data-reveal]");
      const nudgeLinks = gsap.utils.toArray<HTMLElement>(
        ".intro-link, .project-link, .text-link, .ledger-source a, .site-footer a, #contact-path a",
      );
      // The nudge animates the trailing arrow when a link has one, so the arrow
      // is what must be cleaned up when motion is switched off. Contact links
      // also carry a decorative icon span, so the arrow is named explicitly.
      const arrowOf = (element: HTMLElement) =>
        element.querySelector<HTMLElement>(".contact-arrow") ??
        element.querySelector<HTMLElement>('span[aria-hidden="true"]');
      const nudgeTargets = nudgeLinks.map(
        (element) => arrowOf(element) ?? element,
      );

      let active = false;
      let revealObserver: IntersectionObserver | undefined;
      // Retain each grouped reveal so teardown explicitly cancels every
      // delivery, including groups that overlap within the reveal window.
      let revealTweens: gsap.core.Tween[] = [];
      let focusInHandler: ((event: Event) => void) | undefined;
      let scrollHandler: (() => void) | undefined;
      let scrollFrame = 0;

      function settle(targets: HTMLElement[]) {
        // Cancel any in-flight reveal first: otherwise a running opacity/y tween
        // repaints its earlier pose on the next frame, undoing this settlement.
        gsap.killTweensOf(targets, "opacity,y");
        gsap.set(targets, { opacity: 1, y: 0 });
      }

      function stopMotion() {
        revealObserver?.disconnect();
        revealObserver = undefined;
        if (focusInHandler) document.removeEventListener("focusin", focusInHandler);
        if (scrollHandler) {
          window.removeEventListener("scroll", scrollHandler);
          window.removeEventListener("hashchange", scrollHandler);
        }
        if (scrollFrame) cancelAnimationFrame(scrollFrame);
        focusInHandler = undefined;
        scrollHandler = undefined;
        scrollFrame = 0;
        // Stop the grouped reveals before clearing their inline styles.
        for (const tween of revealTweens) tween.kill();
        revealTweens = [];
        gsap.killTweensOf([...revealTargets, ...nudgeTargets]);
        gsap.set(nudgeTargets, { clearProps: "transform" });
        root.classList.remove("motion");
        gsap.set(revealTargets, { clearProps: "all" });
        active = false;
      }

      function startMotion() {
        if (active) return;
        active = true;
        root.classList.add("motion");

        if (revealTargets.length) {
          revealObserver = new IntersectionObserver(
            (entries) => {
              // A queued callback can still be delivered after stopMotion ran
              // (e.g. a preference change mid-scroll). Starting a reveal tween
              // then would repaint hidden/offset state the settle just cleared.
              if (!active) return;
              const entering = entries
                .filter((entry) => entry.isIntersecting)
                .map((entry) => entry.target as HTMLElement);
              for (const target of entering) revealObserver?.unobserve(target);
              if (!entering.length) return;
              gsap.killTweensOf(entering, "opacity,y");
              revealTweens.push(
                gsap.to(entering, {
                  opacity: 1,
                  y: 0,
                  duration: 0.6,
                  ease: "power2.out",
                  stagger: 0.06,
                }),
              );
            },
            { rootMargin: "0px 0px -10% 0px" },
          );
          for (const target of revealTargets) revealObserver.observe(target);
        }

        focusInHandler = (event) => {
          const node = event.target;
          if (!(node instanceof Element)) return;
          const target = node.closest<HTMLElement>("[data-reveal]");
          if (target) settle([target]);
        };
        document.addEventListener("focusin", focusInHandler);

        // IntersectionObserver computes intersections on rendering frames, so a
        // fast scroll, an instant jump, or a deep-link landing can pass an
        // element without it ever being reported as intersecting. Anything
        // already scrolled past the viewport is settled here, so no target can
        // stay permanently hidden.
        const settlePassed = () => {
          const passed = revealTargets.filter(
            (target) =>
              Number(getComputedStyle(target).opacity) < 1 &&
              target.getBoundingClientRect().bottom <= 0,
          );
          if (!passed.length) return;
          for (const target of passed) revealObserver?.unobserve(target);
          settle(passed);
        };

        scrollHandler = () => {
          if (scrollFrame) return;
          scrollFrame = requestAnimationFrame(() => {
            scrollFrame = 0;
            settlePassed();
          });
        };
        window.addEventListener("scroll", scrollHandler, { passive: true });
        // A deep link may have scrolled before this module ran, so sweep once.
        requestAnimationFrame(settlePassed);
        window.addEventListener("hashchange", scrollHandler);
      }

      for (const element of nudgeLinks) {
        const arrow = arrowOf(element);
        const nudge = (direction: number) => {
          if (!active) return;
          gsap.to(arrow ?? element, {
            x: direction * 4,
            duration: 0.22,
            ease: "power2.out",
            overwrite: "auto",
          });
        };
        element.addEventListener("pointerenter", () => nudge(1));
        element.addEventListener("pointerleave", () => nudge(0));
        element.addEventListener("focus", () => nudge(1));
        element.addEventListener("blur", () => nudge(0));
      }

      // Evidence Ledger: on a fine pointer, hovering anywhere in a record — the
      // summary or its Source links — opens that record without a click, while
      // native details/summary still owns keyboard and touch. Opening and closing
      // are animated (and reverse cleanly), driven by a small local controller
      // that never writes scroll. It enhances the summary's own activation with
      // preventDefault so the panel animates; it does not capture wheel, touch,
      // or key input. The Source paragraph sits outside `details`, so its links
      // stay visible and clickable whether the panel is open or closed. A short
      // hover-intent delay keeps the row stable while the pointer crosses it, and
      // only a genuine mouse click that lands on a row this hover opened is
      // absorbed, so it cannot immediately toggle the row closed again.
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      type LedgerRecord = {
        details: HTMLDetailsElement;
        row: HTMLElement;
        summary: HTMLElement;
        panel: HTMLElement;
        open: boolean;
        tween: gsap.core.Tween | undefined;
      };
      const ledgerRecords: LedgerRecord[] = gsap.utils
        .toArray<HTMLDetailsElement>(".evidence-ledger details")
        .map((details) => ({
          details,
          row: details.parentElement as HTMLElement,
          summary: details.querySelector("summary") as HTMLElement,
          panel: details.querySelector(".ledger-panel") as HTMLElement,
          open: details.open,
          tween: undefined,
        }));
      const HOVER_INTENT = 110;
      let hoverTimer = 0;
      let hoverOpened: LedgerRecord | undefined;
      let lastPointerType = "mouse";
      let keyboard = false;

      function clearIntent() {
        window.clearTimeout(hoverTimer);
      }

      // Settle a panel to its logical state: `record.open` is the logical target,
      // and it is written to the native `open` attribute here while the animated
      // inline height/opacity is cleared, so the natural layout takes over.
      function settlePanel(record: LedgerRecord) {
        record.tween?.kill();
        record.tween = undefined;
        record.details.open = record.open;
        gsap.set(record.panel, { clearProps: "height,opacity,overflow" });
      }

      function settleAllPanels() {
        for (const record of ledgerRecords) settlePanel(record);
      }

      function expand(record: LedgerRecord, open: boolean) {
        if (record.open === open) return;
        record.open = open;
        const from = record.details.open
          ? record.panel.getBoundingClientRect().height
          : 0;
        record.tween?.kill();
        if (motionQuery.matches) {
          settlePanel(record);
          return;
        }
        // Keep the details open while its panel shrinks to zero, so a closing row
        // animates instead of snapping.
        record.details.open = true;
        gsap.set(record.panel, { height: from, overflow: "hidden" });
        record.tween = gsap.to(record.panel, {
          height: open ? record.panel.scrollHeight : 0,
          opacity: open ? 1 : 0,
          duration: 0.38,
          ease: "power2.inOut",
          overwrite: "auto",
          onComplete: () => settlePanel(record),
        });
      }

      // Exclusivity for every path — hover, click, keyboard and touch: close the
      // other records, then set this one. Animated here rather than by the native
      // group name (which JS removes), so the closing row also eases shut.
      function exclusive(record: LedgerRecord, open: boolean) {
        for (const other of ledgerRecords) {
          if (other !== record) expand(other, false);
        }
        expand(record, open);
      }

      function openRow(record: LedgerRecord) {
        const wasOpen = record.open;
        exclusive(record, true);
        // Only claim a row this hover actually opened; a row already open by
        // default or keyboard stays a native toggle.
        hoverOpened = wasOpen ? undefined : record;
      }

      for (const record of ledgerRecords) {
        // No-JS keeps native mutual exclusion; JS owns the animated coordination.
        record.details.removeAttribute("name");
        // The whole row is the hover surface, so the pointer can rest on a
        // Source link and still open the record.
        record.row.addEventListener("pointerenter", (event) => {
          if (!finePointer.matches) return;
          if ((event as PointerEvent).pointerType !== "mouse") return;
          keyboard = false;
          clearIntent();
          hoverTimer = window.setTimeout(() => openRow(record), HOVER_INTENT);
        });
        record.row.addEventListener("pointerleave", clearIntent);
        record.row.addEventListener("pointerdown", (event) => {
          // A real press ends the hover deliberation: cancel any pending intent
          // so it cannot open a row the press is about to toggle.
          lastPointerType = (event as PointerEvent).pointerType || "mouse";
          clearIntent();
        });
        record.summary.addEventListener("keydown", () => {
          // Keyboard activation is an explicit choice: cancel any pending hover
          // intent and drop the hover claim, so a following click (detail 0) is
          // never treated as hover absorption.
          keyboard = true;
          clearIntent();
          hoverOpened = undefined;
        });
        record.summary.addEventListener("click", (event) => {
          clearIntent();
          // Explicit activation (keyboard Space/Enter, touch/pen tap, or a real
          // mouse click that is not absorbing the hover it just caused) toggles
          // the row through the same exclusive path, so no other row is left open.
          const mouse =
            !keyboard &&
            (event as MouseEvent).detail > 0 &&
            lastPointerType === "mouse";
          // Enhance the summary's own activation so the panel animates; the click
          // is still this row's own summary activation, not a captured gesture.
          event.preventDefault();
          if (mouse && record.open && hoverOpened === record) {
            hoverOpened = undefined;
            return;
          }
          hoverOpened = undefined;
          exclusive(record, !record.open);
        });
      }

      function syncMotionPreference() {
        if (motionQuery.matches) {
          // A reduced-motion change must land every disclosure at its logical
          // state, not only the reveal/nudge tweens.
          settleAllPanels();
          if (active) stopMotion();
          return;
        }
        startMotion();
      }

      motionQuery.addEventListener("change", syncMotionPreference);
      syncMotionPreference();
      window.__afterHoursMotionReady = true;
    </script>
  </body>
</html>
