---
import EvidenceLedger from "../components/EvidenceLedger.svelte";
import SignalField from "../components/SignalField.svelte";

const githubProfile = "https://github.com/FlaBBB";
const linkedInProfile = "https://www.linkedin.com/in/fikri-flab/";
const email = "f12345ff67@gmail.com";

const profileRecords = [
  {
    capability: "TypeScript web applications",
    observedEvidence:
      "TypeScript web and realtime application structure is publicly visible across JMC and WordyChain.",
    qualification:
      "Public repositories establish hosted project material, not individual proficiency level, employment history, or sole authorship.",
    sources: [
      { name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" },
      { name: "JMC", href: "https://github.com/FlaBBB/JMC" },
    ],
  },
  {
    capability: "Modular application design with automated tests",
    observedEvidence:
      "WordyChain visibly separates realtime, web, shared, dictionary, and game-core packages; its public tree includes unit-flow, end-to-end, and package-level tests.",
    qualification:
      "Present this as visible project structure and test coverage, not a blanket claim about every component’s authorship.",
    sources: [{ name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" }],
  },
  {
    capability: "Project-specific web-stack exposure",
    observedEvidence:
      "JMC documents Next.js App Router, TypeScript, PostgreSQL/Prisma, NextAuth.js v5, Tailwind CSS v4, Bun, Docker, Piston-backed code execution, and multiple submission languages.",
    qualification:
      "Attribute the stack to JMC. Do not present it as a personal expert-stack list or as proof of individual implementation depth; the README says the project was written by AI.",
    sources: [{ name: "JMC", href: "https://github.com/FlaBBB/JMC" }],
  },
  {
    capability: "Security-learning archive",
    observedEvidence:
      "A public cybersecurity archive contains CTF-oriented material for cryptography, digital forensics, reverse engineering, and binary exploitation.",
    qualification:
      "Label it a learning archive, not professional security work, a certification, or a claim of production security responsibility.",
    sources: [{ name: "Cybers_security", href: "https://github.com/FlaBBB/Cybers_security" }],
  },
];

const sections = [
  { id: "identity", label: "00 / identity" },
  { id: "technical-profile", label: "01 / Technical Profile" },
  { id: "selected-evidence", label: "02 / selected evidence" },
  { id: "learning-archive", label: "03 / learning archive" },
  { id: "contact-path", label: "04 / Contact Path" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Signal Ledger — Fikri Flab</title>
    <link rel="canonical" href="https://flab.my.id/" />
  </head>
  <body>

    <main>
      <section id="identity" aria-labelledby="identity-heading">
        <SignalField client:media="(prefers-reduced-motion: no-preference)" />
        <h1>Fikri <span>Flab</span></h1>
        <h2 id="identity-heading">00 / identity</h2>
        <p>Project-scoped engineering evidence.</p>
        <a
          href={githubProfile}
          target="_blank"
          rel="noreferrer"
          aria-label="Inspect public work (opens in a new tab)"
        >
          Inspect public work ↗
        </a>
      </section>
      <header>
        <nav aria-label="Portfolio sections">
          <ol>
            {
              sections.map(({ id, label }) => (
                <li><a href={`#${id}`}>{label}</a></li>
              ))
            }
          </ol>
        </nav>
      </header>

      <section id="technical-profile" aria-labelledby="technical-profile-heading">
        <h2 id="technical-profile-heading">01 / Technical Profile</h2>
        <p>A curated record of publicly visible projects and learning material.</p>
        <EvidenceLedger records={profileRecords} client:visible />
      </section>

      <section id="selected-evidence" aria-labelledby="selected-evidence-heading">
        <h2 id="selected-evidence-heading">02 / selected evidence</h2>
        <article aria-labelledby="wordychain-heading">
          <p>Selected evidence / 01</p>
          <h3 id="wordychain-heading">Realtime and web boundaries, kept visible.</h3>
          <p>
            Public project structure separates realtime, web, shared, dictionary, and game-core packages; unit-flow,
            end-to-end, and package-level test directories are visible.
          </p>
          <p>Repository structure is evidence of visible project organization, not a claim of exclusive authorship.</p>
          <a href="https://github.com/FlaBBB/WordyChain">Inspect WordyChain ↗</a>
        </article>
        <article aria-labelledby="jmc-heading">
          <p>Selected evidence / 02</p>
          <h3 id="jmc-heading">A documented web application stack.</h3>
          <p>
            JMC documents a Next.js and TypeScript application with PostgreSQL/Prisma, NextAuth.js, Tailwind CSS,
            Bun, Docker, and sandboxed multi-language code execution.
          </p>
          <p>
            This describes JMC’s documented stack. It does not assert individual authorship or proficiency; its README
            says the project was written by AI.
          </p>
          <a href="https://github.com/FlaBBB/JMC">Inspect JMC ↗</a>
        </article>
      </section>

      <section id="learning-archive" aria-labelledby="learning-archive-heading">
        <h2 id="learning-archive-heading">03 / learning archive</h2>
        <p>Learning archive</p>
        <h3>Security material, explicitly scoped.</h3>
        <p>
          A public CTF-oriented archive spans cryptography, digital forensics, reverse engineering, and binary
          exploitation.
        </p>
        <p>Learning material, not professional security experience.</p>
        <a href="https://github.com/FlaBBB/Cybers_security">Inspect Cybers_security ↗</a>
      </section>

      <section id="contact-path" aria-labelledby="contact-path-heading">
        <h2 id="contact-path-heading">04 / Contact Path</h2>
        <ul>
          <li><a href={githubProfile}>GitHub — inspect public work ↗</a></li>
          <li><a href={linkedInProfile}>LinkedIn — professional profile ↗</a></li>
          <li><a href={`mailto:${email}`}>Email — start a conversation ↗</a></li>
        </ul>
      </section>
    </main>
    <style is:global>
      :root {
        --background: #0a0b0d;
        --ink: #f2f0e9;
        --muted-ink: #a8a79f;
        --rule: #2a2d31;
        --signal: #d6ff33;
        --contact: #2246ff;
        --annotation: #ff7058;
        --gutter: 4.5rem;
        color-scheme: dark;
        font-family: Inter, "Helvetica Neue", Arial, sans-serif;
        font-synthesis: none;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--background);
        scroll-behavior: smooth;
      }

      body {
        min-width: 20rem;
        margin: 0;
        background: var(--background);
        color: var(--ink);
        font-size: 1rem;
        line-height: 1.5;
      }

      a {
        color: inherit;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--signal);
        outline-offset: 4px;
      }

      header {
        position: sticky;
        top: 2rem;
        z-index: 1;
        width: 3rem;
        height: 0;
        transform: translateX(-4.5rem);
      }

      header ol,
      #contact-path ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      header li {
        margin-block-end: 0.75rem;
      }

      header a {
        color: var(--muted-ink);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        line-height: 1.25;
        text-decoration: none;
      }

      header a:hover,
      header a:focus-visible {
        color: var(--signal);
      }

      main {
        margin-inline-start: 6rem;
      }

      section {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
        row-gap: 1.5rem;
        padding: 4rem var(--gutter);
        border-block-start: 1px solid var(--rule);
      }

      h1,
      h2,
      h3,
      p,
      ol,
      ul,
      dl,
      dd {
        margin: 0;
      }

      h1,
      h2,
      h3 {
        font-weight: 650;
        letter-spacing: -0.055em;
        line-height: 0.88;
      }

      h1 {
        grid-column: 1 / span 8;
        align-self: end;
        max-inline-size: 8ch;
        font-size: clamp(4rem, 12vw, 12rem);
      }

      h1 span {
        display: block;
      }

      h2,
      #identity > p,
      #identity > a {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        line-height: 1.35;
        text-transform: uppercase;
      }

      h2 {
        grid-column: 9 / -1;
        align-self: start;
        color: var(--signal);
      }

      #identity {
        position: relative;
        min-height: 100svh;
        align-items: end;
        border: 0;
      }

      #identity::before {
        position: absolute;
        inset: var(--gutter);
        border: 1px solid var(--rule);
        content: "";
        pointer-events: none;
      }

      .signal-field {
        position: absolute;
        inset: var(--gutter);
        overflow: hidden;
        background-image:
          linear-gradient(var(--rule) 1px, transparent 1px),
          linear-gradient(90deg, var(--rule) 1px, transparent 1px);
        background-size: 4rem 4rem;
        opacity: 0.7;
      }

      .signal-field canvas {
        width: 100%;
        height: 100%;
        animation: signal-field-entry 700ms ease-out both;
      }

      #identity > :not(astro-island) {
        position: relative;
        z-index: 1;
      }

      @keyframes signal-field-entry {
        from {
          opacity: 0;
        }

        to {
          opacity: 1;
        }
      }

      #identity > p {
        grid-column: 9 / span 3;
        color: var(--muted-ink);
      }

      #identity > a {
        grid-column: 10 / -1;
        justify-self: end;
        color: var(--ink);
      }

      #technical-profile > p {
        grid-column: 1 / span 6;
        color: var(--muted-ink);
        font-size: 1.125rem;
      }

      #technical-profile [aria-label="Technical Profile evidence ledger"] {
        grid-column: 1 / -1;
        display: grid;
        gap: 0;
        padding: 0;
        list-style: none;
        border-block-end: 1px solid var(--rule);
        counter-reset: ledger;
      }

      #technical-profile [aria-label="Technical Profile evidence ledger"] > li {
        position: relative;
        padding: 1.5rem 0;
        border-block-start: 1px solid var(--rule);
        counter-increment: ledger;
      }

      #technical-profile [aria-label="Technical Profile evidence ledger"] > li::before {
        position: absolute;
        top: 1.5rem;
        left: -2.5rem;
        color: var(--annotation);
        content: "0" counter(ledger);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
      }

      #technical-profile dl {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1.5rem;
      }

      #technical-profile .ledger-field {
        display: grid;
        align-content: start;
        gap: 0.5rem;
      }

      #technical-profile .ledger-capability {
        grid-column: span 3;
      }

      #technical-profile .ledger-disclosure {
        width: fit-content;
        margin-block-start: 0.5rem;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--signal);
        cursor: pointer;
        font: inherit;
        font-size: 0.75rem;
        text-align: start;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      #technical-profile .ledger-details {
        display: grid;
        grid-column: span 9;
        grid-template-columns: repeat(9, minmax(0, 1fr));
        gap: 1.5rem;
      }

      #technical-profile .ledger-details[hidden] {
        display: none;
      }

      #technical-profile .ledger-details > :first-child {
        grid-column: span 5;
      }

      #technical-profile .ledger-details > :last-child {
        grid-column: span 4;
      }

      #technical-profile .ledger-source {
        grid-column: 1 / -1;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        padding-block-start: 1rem;
        border-block-start: 1px solid var(--rule);
      }

      #technical-profile .ledger-source dt {
        grid-column: span 3;
      }

      #technical-profile .ledger-source dd {
        grid-column: 4 / -1;
      }

      dt,
      #selected-evidence article > p:first-child,
      #learning-archive > p:first-of-type {
        color: var(--muted-ink);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        line-height: 1.35;
        text-transform: uppercase;
      }

      dd {
        overflow-wrap: anywhere;
      }

      #technical-profile dd {
        font-size: 0.9375rem;
      }

      #technical-profile .ledger-details > :last-child dd {
        color: var(--muted-ink);
      }

      #technical-profile a {
        color: var(--signal);
      }

      #selected-evidence > article {
        display: grid;
        gap: 1.5rem;
        align-content: start;
        min-height: 28rem;
        padding: 1.5rem;
        border: 1px solid var(--rule);
      }

      #selected-evidence > article:first-of-type {
        grid-column: 1 / span 7;
      }

      #selected-evidence > article:last-of-type {
        grid-column: 8 / -1;
        margin-block-start: 6rem;
      }

      #selected-evidence h3,
      #learning-archive h3 {
        font-size: clamp(2.25rem, 4vw, 4.5rem);
      }

      #selected-evidence article > p:nth-of-type(2) {
        color: var(--muted-ink);
      }

      #selected-evidence article > a,
      #learning-archive > a {
        align-self: end;
        color: var(--signal);
      }

      #learning-archive {
        min-height: 70svh;
        align-content: center;
      }

      #learning-archive h3 {
        grid-column: 1 / span 8;
      }

      #learning-archive > p:not(:first-of-type) {
        grid-column: 9 / -1;
        color: var(--muted-ink);
      }

      #learning-archive > a {
        grid-column: 9 / -1;
      }

      #contact-path {
        min-height: 70svh;
        align-content: space-between;
        background: var(--contact);
        border-color: var(--ink);
      }

      #contact-path h2 {
        color: var(--ink);
      }

      #contact-path ul {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        align-self: end;
      }

      #contact-path a {
        display: flex;
        align-items: center;
        min-height: 4rem;
        padding: 0.75rem 0;
        border-block-start: 1px solid currentColor;
        font-size: clamp(1.125rem, 2vw, 2rem);
      }

      @media (max-width: 720px) {
        :root {
          --gutter: 1.25rem;
        }

        html {
          scroll-behavior: auto;
        }

        header {
          display: none;
        }

        main {
          margin: 0;
        }

        section {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          padding-block: 3rem;
        }

        #identity {
          min-height: 44rem;
          background-size: 3rem 3rem;
        }

        h1,
        h2,
        #identity > p,
        #identity > a,
        #technical-profile > p,
        #learning-archive h3,
        #learning-archive > p:not(:first-of-type),
        #learning-archive > a {
          grid-column: 1;
        }

        h1 {
          font-size: clamp(4rem, 22vw, 7rem);
        }

        h2 {
          grid-row: 1;
        }

        #technical-profile [aria-label="Technical Profile evidence ledger"] {
          grid-column: 1;
        }

        #technical-profile [aria-label="Technical Profile evidence ledger"] > li {
          padding-inline-start: 2.5rem;
        }

        #technical-profile [aria-label="Technical Profile evidence ledger"] > li::before {
          left: 0;
        }

        #technical-profile dl,
        #technical-profile .ledger-details,
        #technical-profile .ledger-source {
          grid-template-columns: 1fr;
          gap: 1.25rem;
        }

        #technical-profile .ledger-capability,
        #technical-profile .ledger-details,
        #technical-profile .ledger-source,
        #technical-profile .ledger-details > :first-child,
        #technical-profile .ledger-details > :last-child,
        #technical-profile .ledger-source dt,
        #technical-profile .ledger-source dd {
          grid-column: 1;
        }

        #selected-evidence > article:first-of-type,
        #selected-evidence > article:last-of-type {
          grid-column: 1;
          min-height: 0;
          margin: 0;
        }

        #learning-archive {
          min-height: 0;
        }

        #contact-path {
          min-height: 0;
        }

        #contact-path ul {
          grid-column: 1;
          grid-template-columns: 1fr;
          gap: 0;
        }

        #contact-path a {
          min-height: 2.75rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </body>
</html>
