---
import EvidenceLedger from "../components/EvidenceLedger.svelte";
import Icon from "../components/Icon.astro";
import "../styles/portfolio.css";

const githubProfile = "https://github.com/FlaBBB";
const linkedInProfile = "https://www.linkedin.com/in/fikri-flab/";
const email = "f12345ff67@gmail.com";
const title = "Fikri Flab — Projects and Play";
const description = "Fikri Flab’s Portfolio Site: explore TypeScript web projects, realtime application structure, and a security-learning archive through public source material.";

const profileRecords = [
  {
    capability: "TypeScript web applications",
    observedEvidence:
      "TypeScript web and realtime application structure is publicly visible across JMC and WordyChain.",
    qualification:
      "Public repositories establish hosted project material, not individual proficiency level, employment history, or sole authorship.",
    sources: [
      { name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" },
      { name: "JMC", href: "https://github.com/FlaBBB/JMC" },
    ],
  },
  {
    capability: "Modular application design with automated tests",
    observedEvidence:
      "WordyChain visibly separates realtime, web, shared, dictionary, and game-core packages; its public tree includes unit-flow, end-to-end, and package-level tests.",
    qualification:
      "Visible project structure and tests do not establish authorship of every component.",
    sources: [{ name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" }],
  },
  {
    capability: "Project-specific web-stack exposure",
    observedEvidence:
      "JMC documents Next.js App Router, TypeScript, PostgreSQL/Prisma, NextAuth.js v5, Tailwind CSS v4, Bun, Docker, Piston-backed code execution, and multiple submission languages.",
    qualification:
      "This is JMC’s documented stack, not a personal proficiency claim; the README says the project was written by AI.",
    sources: [{ name: "JMC", href: "https://github.com/FlaBBB/JMC" }],
  },
  {
    capability: "Security-learning archive",
    observedEvidence:
      "A public cybersecurity archive contains CTF-oriented material for cryptography, digital forensics, reverse engineering, and binary exploitation.",
    qualification:
      "A learning archive, not professional security work, a certification, or production security responsibility.",
    sources: [{ name: "Cybers_security", href: "https://github.com/FlaBBB/Cybers_security" }],
  },
];

const sections = [
  { id: "selected-evidence", label: "Work" },
  { id: "technical-profile", label: "Profile" },
  { id: "contact-path", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f3eb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://flab.my.id/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://flab.my.id/" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="#identity" aria-label="Fikri Flab — back to top"><img class="brand-mark" src="/favicon.svg" width="48" height="48" alt="" />Fikri Flab</a>
        <nav aria-label="Portfolio sections">
          <ul>{sections.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <section id="identity" class="shell" aria-labelledby="identity-heading">
        <div class="hero-copy">
          <p class="hero-kicker">A little code. A lot of curiosity.</p>
          <h1 id="identity-heading"><span>Build.</span><span>Break.</span><span>Learn<span class="end-mark">.</span></span></h1>
          <p class="hero-note">TypeScript web projects.<br />Realtime structure.<br />Learning in public.</p>
          <div class="hero-actions">
            <a class="primary-link paper paper--press" href="#selected-evidence">Explore projects <Icon name="arrow-right" /></a>
            <a class="secondary-link" href="#contact-path">Get in touch <Icon name="arrow-up-right" /></a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="hero-art" aria-hidden="true">
            <div class="hero-layer hero-backdrop" data-depth="-0.35"></div>
            <img class="hero-layer hero-crystals-back" data-depth="0.5" src="/hero-crystals-back.webp" width="1728" height="1152" alt="" decoding="async" />
            <img class="hero-layer hero-image" data-depth="1" src="/hero-character.webp" width="1728" height="1152" alt="" fetchpriority="high" decoding="async" />
            <img class="hero-layer hero-crystals-front" data-depth="1.6" src="/hero-crystals-front.webp" width="1728" height="1152" alt="" decoding="async" />
          </div>
          <p class="art-caption"><span class="paper caption-tag">Same curiosity.<br />More building.</span></p>
        </div>
        <div class="hero-footnote">
          <span>Fikri Flab / Projects and Play</span>
          <a href={githubProfile} target="_blank" rel="noreferrer" aria-label="Inspect public work (opens in a new tab)">Open source, open to inspection <Icon name="arrow-up-right" /></a>
        </div>
      </section>

      <section id="selected-evidence" class="shell chapter" aria-labelledby="selected-evidence-heading">
        <div class="section-heading">
          <div><p class="eyebrow">01 / The work</p><h2 id="selected-evidence-heading">Selected Work</h2></div>
          <p class="section-intro">A closer look at the source.<br />Structure, stacks, and experiments.</p>
        </div>
        <div class="project-list">
          <article class="project paper" aria-labelledby="wordychain-heading">
            <span class="project-number" aria-hidden="true">01</span>
            <div class="project-copy">
              <h3 id="wordychain-heading">WordyChain</h3>
              <p>Visible package boundaries and automated tests.</p>
              <ul class="project-stack" aria-label="WordyChain packages"><li>web</li><li>realtime</li><li>shared</li><li>dictionary</li><li>game-core</li></ul>
            </div>
            <a class="project-link" href="https://github.com/FlaBBB/WordyChain" aria-label="View WordyChain repository">View source <Icon name="arrow-up-right" /></a>
          </article>
          <article class="project project--jmc paper" aria-labelledby="jmc-heading">
            <span class="project-number" aria-hidden="true">02</span>
            <div class="project-copy">
              <h3 id="jmc-heading">JMC</h3>
              <p>A publicly documented web application stack.</p>
              <ul class="project-stack" aria-label="JMC documented stack"><li>Next.js</li><li>TypeScript</li><li>PostgreSQL</li><li>Prisma</li></ul>
            </div>
            <a class="project-link" href="https://github.com/FlaBBB/JMC" aria-label="View JMC repository">View source <Icon name="arrow-up-right" /></a>
          </article>
        </div>
        <p class="work-scope">Public project material, not a claim of sole authorship or proficiency. JMC’s README says the project was written by AI. See <a href="#profile-sources">Sources &amp; scope</a> for the full qualifications.</p>
      </section>

      <section id="technical-profile" class="profile-section" aria-labelledby="technical-profile-heading">
        <div class="shell chapter">
          <div class="section-heading">
            <div><p class="eyebrow">02 / Under the surface</p><h2 id="technical-profile-heading">Technical Profile</h2></div>
            <p class="section-intro">What the public material shows.<br />And where its limits are.</p>
          </div>
          <div class="profile-overview">
            <div class="profile-topic"><span class="topic-tag paper">Web / realtime</span><h3>TypeScript<br />applications.</h3><p>Application structure visible across WordyChain and JMC.</p></div>
            <div class="profile-topic"><span class="topic-tag paper">Structure / tests</span><h3>Pieces that<br />fit together.</h3><p>Package boundaries and automated tests in WordyChain.</p></div>
            <div class="profile-topic"><span class="topic-tag paper">Notes / exploration</span><h3>Learning<br />in the open.</h3><p>A CTF-oriented archive—not professional security experience.</p></div>
          </div>
          <details id="profile-sources" class="profile-sources paper">
            <summary><span class="notes-label"><Icon name="repository" /><span><strong>Sources &amp; scope</strong><small>The evidence behind this profile</small></span></span><span class="notes-toggle"><Icon name="plus" /></span></summary>
            <p class="notes-intro">The project evidence behind this profile, including what it does—and doesn’t—establish.</p>
            <EvidenceLedger records={profileRecords} />
          </details>
        </div>
      </section>

      <section id="learning-archive" class="shell chapter" aria-labelledby="learning-archive-heading">
        <div class="archive-heading"><span class="archive-tab paper">Still curious.</span><h2 id="learning-archive-heading">Learning, out in the open.</h2></div>
        <div class="archive-copy"><p>Cryptography, forensics, reverse engineering, and binary exploitation. CTF notes—not professional security experience.</p><a class="text-link" href="https://github.com/FlaBBB/Cybers_security"><Icon name="gem" />Cybers_security archive <Icon name="arrow-up-right" /></a></div>
      </section>

      <section id="contact-path" class="shell chapter" aria-labelledby="contact-path-heading">
        <div class="contact-sheet paper">
          <div class="contact-copy"><p class="eyebrow">03 / The next conversation</p><h2 id="contact-path-heading">Say hello<span class="end-mark">.</span></h2><p class="contact-intro">A project, a question,<br />or just a conversation.</p></div>
          <ul class="contact-links">
            <li><!--email_off--><a class="contact-link contact-link--email paper paper--press" href={`mailto:${email}`} aria-label="Email"><Icon name="mail" /><span><strong>Email</strong><small>{email}</small></span><Icon name="arrow-up-right" /></a><!--/email_off--></li>
            <li><a class="contact-link" href={githubProfile} aria-label="GitHub"><Icon name="repository" /><span><strong>GitHub</strong><small>Explore the public work</small></span><Icon name="arrow-up-right" /></a></li>
            <li><a class="contact-link" href={linkedInProfile} aria-label="LinkedIn"><Icon name="conversation" /><span><strong>LinkedIn</strong><small>Connect with Fikri</small></span><Icon name="arrow-up-right" /></a></li>
          </ul>
        </div>
      </section>
    </main>
    <footer class="site-footer shell"><a class="wordmark" href="#identity" aria-label="Fikri Flab — home"><img class="brand-mark" src="/favicon.svg" width="42" height="42" alt="" />Fikri Flab</a><span>Projects and Play / Made with curiosity.</span><a class="text-link" href="#identity">Back to top <Icon name="arrow-up-right" /></a></footer>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      const motion = gsap.matchMedia();
      // New triggers can clear GSAP's saved scroll position during a media refresh.
      let mediaPosition: { left: number; top: number } | undefined;
      // GSAP's public event API is missing from its published TypeScript declarations.
      (gsap as typeof gsap & { addEventListener(event: "matchMediaInit", callback: () => void): void }).addEventListener("matchMediaInit", () => {
        mediaPosition = { left: window.scrollX, top: window.scrollY };
      });
      ScrollTrigger.addEventListener("matchMedia", () => {
        if (!mediaPosition) return;
        window.scrollTo({ ...mediaPosition, behavior: "instant" });
        mediaPosition = undefined;
        ScrollTrigger.update();
      });
      motion.add("(prefers-reduced-motion: no-preference)", () => {
        gsap.from(".hero-copy > *", { y: 18, opacity: 0, duration: 0.65, stagger: 0.09, ease: "power2.out", clearProps: "opacity,transform" });
        gsap.from(".hero-visual", { y: 24, opacity: 0, duration: 0.9, delay: 0.12, ease: "power2.out", clearProps: "opacity,transform" });
        gsap.utils.toArray<HTMLElement>("#selected-evidence article, #learning-archive").forEach((element) => {
          gsap.from(element, { y: 24, duration: 0.7, ease: "power2.out", clearProps: "transform", scrollTrigger: { trigger: element, start: "top 95%", once: true } });
        });

        const profile = document.querySelector<HTMLElement>("#technical-profile")!;
        const field = document.querySelector<HTMLElement>(".hero-art")!;
        const parallax = gsap.timeline({ paused: true });
        const layers = Array.from(field.querySelectorAll<HTMLElement>("[data-depth]")).map((element) => {
          const depth = Number(element.dataset.depth);
          parallax.to(element, { yPercent: -8 * depth, ease: "none" }, 0);
          return {
            depth,
            xTo: gsap.quickTo(element, "x", { duration: 0.55, ease: "power3.out" }),
            yTo: gsap.quickTo(element, "y", { duration: 0.55, ease: "power3.out" }),
          };
        });
        ScrollTrigger.create({ animation: parallax, trigger: "#identity", start: "top top", end: "bottom top", scrub: 0.6 });
        function move(event: PointerEvent) {
          if (event.pointerType === "touch" || document.hidden) return;
          const bounds = field.getBoundingClientRect();
          const distance = Math.min(18, bounds.width * 0.035);
          const x = gsap.utils.clamp(-1, 1, (event.clientX - bounds.left) / bounds.width * 2 - 1) * distance;
          const y = gsap.utils.clamp(-1, 1, (event.clientY - bounds.top) / bounds.height * 2 - 1) * distance;
          layers.forEach(({ depth, xTo, yTo }) => { xTo(x * depth); yTo(y * depth); });
        }
        function reset() { layers.forEach(({ xTo, yTo }) => { xTo(0); yTo(0); }); }
        function refresh() { ScrollTrigger.refresh(); }
        function visibility() {
          if (document.hidden) layers.forEach(({ xTo, yTo }) => { xTo.tween.pause(); yTo.tween.pause(); });
          else reset();
        }
        profile.addEventListener("toggle", refresh, true);
        field.addEventListener("pointermove", move);
        field.addEventListener("pointerleave", reset);
        document.addEventListener("visibilitychange", visibility);

        return () => {
          profile.removeEventListener("toggle", refresh, true);
          field.removeEventListener("pointermove", move);
          field.removeEventListener("pointerleave", reset);
          document.removeEventListener("visibilitychange", visibility);
        };
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href="#profile-sources"]').forEach((link) => {
        link.addEventListener("click", () => { document.querySelector<HTMLDetailsElement>("#profile-sources")!.open = true; });
      });
    </script>
  </body>
</html>
