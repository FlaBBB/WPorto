---
import EvidenceLedger from "../components/EvidenceLedger.svelte";

const githubProfile = "https://github.com/FlaBBB";
const linkedInProfile = "https://www.linkedin.com/in/fikri-flab/";
const email = "f12345ff67@gmail.com";
const title = "Fikri Flab — Projects and Play";
const description = "Fikri Flab’s Portfolio Site: explore TypeScript web projects, realtime application structure, and a security-learning archive through public source material.";

const profileRecords = [
  {
    capability: "TypeScript web applications",
    observedEvidence:
      "TypeScript web and realtime application structure is publicly visible across JMC and WordyChain.",
    qualification:
      "Public repositories establish hosted project material, not individual proficiency level, employment history, or sole authorship.",
    sources: [
      { name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" },
      { name: "JMC", href: "https://github.com/FlaBBB/JMC" },
    ],
  },
  {
    capability: "Modular application design with automated tests",
    observedEvidence:
      "WordyChain visibly separates realtime, web, shared, dictionary, and game-core packages; its public tree includes unit-flow, end-to-end, and package-level tests.",
    qualification:
      "Visible project structure and tests do not establish authorship of every component.",
    sources: [{ name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" }],
  },
  {
    capability: "Project-specific web-stack exposure",
    observedEvidence:
      "JMC documents Next.js App Router, TypeScript, PostgreSQL/Prisma, NextAuth.js v5, Tailwind CSS v4, Bun, Docker, Piston-backed code execution, and multiple submission languages.",
    qualification:
      "This is JMC’s documented stack, not a personal proficiency claim; the README says the project was written by AI.",
    sources: [{ name: "JMC", href: "https://github.com/FlaBBB/JMC" }],
  },
  {
    capability: "Security-learning archive",
    observedEvidence:
      "A public cybersecurity archive contains CTF-oriented material for cryptography, digital forensics, reverse engineering, and binary exploitation.",
    qualification:
      "A learning archive, not professional security work, a certification, or production security responsibility.",
    sources: [{ name: "Cybers_security", href: "https://github.com/FlaBBB/Cybers_security" }],
  },
];

const sections = [
  { id: "selected-evidence", label: "Work" },
  { id: "technical-profile", label: "Profile" },
  { id: "contact-path", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7ff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://flab.my.id/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://flab.my.id/" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="#identity" aria-label="Fikri Flab — back to top">Fikri Flab<span aria-hidden="true">✦</span></a>
      <nav aria-label="Portfolio sections">
        <ul>
          {sections.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <section id="identity" aria-labelledby="identity-heading">
        <div class="hero-copy">
          <p class="hero-kicker">A little code. A lot of curiosity.</p>
          <h1 id="identity-heading">Building things.<br /><span>Learning out loud.</span></h1>
          <p class="hero-note">Web applications, realtime projects,<br class="desktop-break" /> and a security-learning archive.</p>
          <div class="hero-actions">
            <a class="primary-link" href="#selected-evidence">Explore projects <span aria-hidden="true">↗</span></a>
            <a class="secondary-link" href="#contact-path">Get in touch</a>
          </div>
          <a class="github-link" href={githubProfile} target="_blank" rel="noreferrer" aria-label="Inspect public work (opens in a new tab)">Open source, open to inspection <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-visual">
          <div class="hero-art" aria-hidden="true">
            <div class="hero-layer hero-backdrop" data-depth="-0.35"></div>
            <img class="hero-layer hero-crystals-back" data-depth="0.5" src="/hero-crystals-back.webp" width="1728" height="1152" alt="" decoding="async" />
            <img class="hero-layer hero-image" data-depth="1" src="/hero-character.webp" width="1728" height="1152" alt="" fetchpriority="high" decoding="async" />
            <img class="hero-layer hero-crystals-front" data-depth="1.6" src="/hero-crystals-front.webp" width="1728" height="1152" alt="" decoding="async" />
          </div>
          <p class="art-caption"><span class="color-dots" aria-hidden="true"><i></i><i></i><i></i></span>A little world of my own.</p>
        </div>
      </section>

      <section id="technical-profile" aria-labelledby="technical-profile-heading">
        <h2 id="technical-profile-heading">Technical Profile</h2>
        <div class="profile-overview">
          <p><span class="profile-symbol" aria-hidden="true">&lt;/&gt;</span><span>TypeScript<br /> applications</span></p>
          <p><span class="profile-symbol" aria-hidden="true">◇</span><span>Modular project<br /> structure</span></p>
          <p><span class="profile-symbol" aria-hidden="true">✧</span><span>Security<br /> learning</span></p>
        </div>
        <details id="profile-sources" class="profile-sources">
          <summary>Sources &amp; scope <span aria-hidden="true">+</span></summary>
          <p class="section-intro">The project evidence behind this profile, including what it does—and doesn’t—establish.</p>
          <EvidenceLedger records={profileRecords} />
        </details>
      </section>

      <section id="selected-evidence" aria-labelledby="selected-evidence-heading">
        <div class="section-heading">
          <h2 id="selected-evidence-heading">Selected Work</h2>
          <p class="section-intro">A closer look at the source.</p>
        </div>
        <article aria-labelledby="wordychain-heading">
          <div class="project-study structure-study" aria-hidden="true">
            <span>Structure study</span>
            <svg viewBox="0 0 200 180" fill="none"><circle cx="73" cy="90" r="48" fill="#a177ef" /><circle cx="55" cy="78" r="48" stroke="#6636b8" /><path d="M138 18L188 73H138Z" fill="#9060e9" /><path d="M100 161L100 100L159 161Z" fill="#75dded" /><path d="M109 163L179 163L144 113Z" fill="#7746d5" /><circle cx="177" cy="104" r="14" fill="#f295db" /><path d="M16 159L41 136M175 40L195 20" stroke="#8d42d9" stroke-width="2" /></svg>
          </div>
          <div class="project-copy">
            <h3 id="wordychain-heading">WordyChain</h3>
            <p>Visible package and test structure.</p>
            <p class="project-stack">web · realtime · shared · dictionary · game-core</p>
            <a class="project-link" href="https://github.com/FlaBBB/WordyChain">View WordyChain repository <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <article aria-labelledby="jmc-heading">
          <div class="project-study stack-study" aria-hidden="true">
            <span>Stack study</span>
            <svg viewBox="0 0 200 180" fill="none"><path d="M20 129L99 102L181 129L100 160Z" fill="#ef9bd6" /><path d="M20 96L99 69L181 96L100 127Z" fill="#70d7e7" /><path d="M20 62L99 35L181 62L100 94Z" fill="#9460e7" /><path d="M100 94V72L181 42V62Z" fill="#7746d5" /><circle cx="151" cy="20" r="9" fill="#a17aee" /><path d="M158 157L179 146M28 41L49 31" stroke="#f3a269" stroke-width="2" /></svg>
          </div>
          <div class="project-copy">
            <h3 id="jmc-heading">JMC</h3>
            <p>A documented web application stack.</p>
            <p class="project-stack">Next.js · TypeScript · PostgreSQL · Prisma</p>
            <a class="project-link" href="https://github.com/FlaBBB/JMC">View JMC repository <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <p class="work-scope">Project material, not a claim of sole authorship or proficiency. JMC’s README says the project was written by AI. Full qualifications are in <a href="#profile-sources">Sources &amp; scope</a>.</p>
      </section>

      <section id="learning-archive" aria-labelledby="learning-archive-heading">
        <span class="archive-symbol" aria-hidden="true">✳</span>
        <div>
          <h2 id="learning-archive-heading">Learning, out in the open.</h2>
          <p>Cryptography, forensics, reverse engineering, and binary exploitation. CTF notes—not professional security experience.</p>
        </div>
        <a class="text-link" href="https://github.com/FlaBBB/Cybers_security">Cybers_security archive <span aria-hidden="true">↗</span></a>
      </section>

      <section id="contact-path" aria-labelledby="contact-path-heading">
        <div>
          <h2 id="contact-path-heading">Say hello.</h2>
          <p class="contact-intro">A project, a question, or just a conversation.</p>
        </div>
        <ul>
          <li><a href={githubProfile}>GitHub <span aria-hidden="true">↗</span></a></li>
          <li><a href={linkedInProfile}>LinkedIn <span aria-hidden="true">↗</span></a></li>
          <li><!--email_off--><a href={`mailto:${email}`}>Email <span aria-hidden="true">↗</span></a><!--/email_off--></li>
        </ul>
      </section>
    </main>
    <footer class="site-footer"><span>Fikri Flab <span aria-hidden="true">✦</span> Projects and Play</span><a href="#identity">Back to top ↑</a></footer>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      const motion = gsap.matchMedia();
      // New triggers can clear GSAP's saved scroll position during a media refresh.
      let mediaPosition: { left: number; top: number } | undefined;
      // GSAP's public event API is missing from its published TypeScript declarations.
      (gsap as typeof gsap & { addEventListener(event: "matchMediaInit", callback: () => void): void }).addEventListener("matchMediaInit", () => {
        mediaPosition = { left: window.scrollX, top: window.scrollY };
      });
      ScrollTrigger.addEventListener("matchMedia", () => {
        if (!mediaPosition) return;
        window.scrollTo({ ...mediaPosition, behavior: "instant" });
        mediaPosition = undefined;
        ScrollTrigger.update();
      });
      motion.add("(prefers-reduced-motion: no-preference)", () => {
        gsap.from(".hero-copy > *", { y: 18, opacity: 0, duration: 0.65, stagger: 0.09, ease: "power2.out", clearProps: "opacity,transform" });
        gsap.from(".hero-visual", { y: 24, opacity: 0, duration: 0.9, delay: 0.12, ease: "power2.out", clearProps: "opacity,transform" });
        gsap.utils.toArray<HTMLElement>("#selected-evidence article, #learning-archive").forEach((element) => {
          gsap.from(element, { y: 24, duration: 0.7, ease: "power2.out", clearProps: "transform", scrollTrigger: { trigger: element, start: "top 95%", once: true } });
        });

        const profile = document.querySelector<HTMLElement>("#technical-profile")!;
        const field = document.querySelector<HTMLElement>(".hero-art")!;
        const parallax = gsap.timeline({ paused: true });
        const layers = Array.from(field.querySelectorAll<HTMLElement>("[data-depth]")).map((element) => {
          const depth = Number(element.dataset.depth);
          parallax.to(element, { yPercent: -8 * depth, ease: "none" }, 0);
          return {
            depth,
            xTo: gsap.quickTo(element, "x", { duration: 0.55, ease: "power3.out" }),
            yTo: gsap.quickTo(element, "y", { duration: 0.55, ease: "power3.out" }),
          };
        });
        ScrollTrigger.create({ animation: parallax, trigger: "#identity", start: "top top", end: "bottom top", scrub: 0.6 });
        function move(event: PointerEvent) {
          if (event.pointerType === "touch" || document.hidden) return;
          const bounds = field.getBoundingClientRect();
          const distance = Math.min(18, bounds.width * 0.035);
          const x = gsap.utils.clamp(-1, 1, (event.clientX - bounds.left) / bounds.width * 2 - 1) * distance;
          const y = gsap.utils.clamp(-1, 1, (event.clientY - bounds.top) / bounds.height * 2 - 1) * distance;
          layers.forEach(({ depth, xTo, yTo }) => { xTo(x * depth); yTo(y * depth); });
        }
        function reset() { layers.forEach(({ xTo, yTo }) => { xTo(0); yTo(0); }); }
        function refresh() { ScrollTrigger.refresh(); }
        function visibility() {
          if (document.hidden) layers.forEach(({ xTo, yTo }) => { xTo.tween.pause(); yTo.tween.pause(); });
          else reset();
        }
        profile.addEventListener("toggle", refresh, true);
        field.addEventListener("pointermove", move);
        field.addEventListener("pointerleave", reset);
        document.addEventListener("visibilitychange", visibility);

        return () => {
          profile.removeEventListener("toggle", refresh, true);
          field.removeEventListener("pointermove", move);
          field.removeEventListener("pointerleave", reset);
          document.removeEventListener("visibilitychange", visibility);
        };
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href="#profile-sources"]').forEach((link) => {
        link.addEventListener("click", () => { document.querySelector<HTMLDetailsElement>("#profile-sources")!.open = true; });
      });
    </script>

    <style is:global>
      :root {
        --background: #faf7ff;
        --surface: #f0e9fb;
        --ink: #21103c;
        --muted-ink: #655379;
        --rule: #d9cce9;
        --signal: #7131d5;
        --gutter: clamp(1.25rem, 5.5vw, 5rem);
        color-scheme: light;
        font-family: "Helvetica Neue", Arial, sans-serif;
        font-synthesis: none;
      }
      * { box-sizing: border-box; }
      html { background: var(--background); scroll-behavior: smooth; scroll-padding-top: 7rem; }
      body { margin: 0; color: var(--ink); background: var(--background); line-height: 1.6; }
      h1, h2, h3, p, ul, ol, dl, dd { margin: 0; }
      a { color: var(--signal); text-underline-offset: 0.25em; text-decoration-thickness: 1px; }
      a, summary { -webkit-tap-highlight-color: transparent; }
      a:focus-visible, summary:focus-visible { outline: 2px solid var(--signal); outline-offset: 4px; }
      main:focus { outline: none; }
      .skip-link { position: fixed; top: 0.75rem; left: var(--gutter); z-index: 20; padding: 0.75rem 1rem; color: white; background: var(--signal); border-radius: 0.5rem; transform: translateY(-200%); }
      .skip-link:focus { transform: translateY(0); }
      .site-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: 90rem; margin-inline: auto; padding: 1rem var(--gutter); background: var(--background); }
      .wordmark { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 2.75rem; flex-shrink: 0; color: var(--ink); text-decoration: none; font-size: 1.35rem; font-weight: 700; letter-spacing: -0.04em; }
      .wordmark span { color: var(--signal); }
      nav ul { display: flex; gap: 2rem; padding: 0; list-style: none; }
      nav a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--ink); text-decoration: none; }
      nav a:hover { color: var(--signal); text-decoration: underline; }
      main, .site-footer { max-width: 90rem; margin-inline: auto; padding-inline: var(--gutter); }
      section { margin-bottom: 3rem; }
      h2 { font-size: 1.5rem; line-height: 1.2; letter-spacing: -0.035em; font-weight: 650; }
      #identity { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 2.5rem; padding-top: 2rem; margin-bottom: 2.5rem; }
      .hero-copy { min-width: 0; }
      .hero-kicker { margin-bottom: 1.1rem; color: var(--signal); font-size: 0.8125rem; font-weight: 600; }
      h1 { font-size: clamp(2.5rem, 4.3vw, 4rem); line-height: 1.07; letter-spacing: -0.055em; font-weight: 750; }
      h1 span { color: #442070; }
      .hero-note { margin-top: 1.4rem; color: var(--muted-ink); font-size: clamp(1.0625rem, 1.65vw, 1.5rem); line-height: 1.45; letter-spacing: -0.02em; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; margin-top: 1.75rem; }
      .primary-link, .secondary-link { display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 3.25rem; padding: 0.65rem 1.4rem; border-radius: 3rem; text-decoration: none; font-weight: 550; }
      .primary-link { color: white; background: var(--signal); border: 1px solid var(--signal); }
      .secondary-link { color: var(--signal); border: 1px solid var(--signal); }
      .primary-link:hover { background: #5721aa; }
      .secondary-link:hover { background: var(--surface); }
      .github-link { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; margin-top: 0.8rem; color: var(--muted-ink); font-size: 0.8125rem; }
      .hero-visual { position: relative; min-width: 0; }
      .hero-art { position: relative; isolation: isolate; aspect-ratio: 3 / 2; }
      .hero-layer { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
      .hero-backdrop { z-index: 0; background: radial-gradient(ellipse at 60% 38%, #d9c3ff99, transparent 65%), radial-gradient(ellipse at 78% 60%, #edbdea66, transparent 55%), radial-gradient(ellipse at 25% 68%, #8ee5ee44, transparent 45%); mask-image: radial-gradient(ellipse, black 15%, transparent 70%); }
      .hero-crystals-back { z-index: 1; opacity: 0.6; }
      .hero-image { z-index: 2; }
      .hero-crystals-front { z-index: 3; }
      .art-caption { display: flex; align-items: center; justify-content: flex-end; gap: 0.7rem; margin-top: 0.6rem; color: var(--muted-ink); font-size: 0.8125rem; }
      .color-dots { display: inline-flex; gap: 0.25rem; }
      .color-dots i { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: #a579eb; }
      .color-dots i:nth-child(2) { background: #4fd6e4; }
      .color-dots i:nth-child(3) { background: #f18ed2; }
      #technical-profile h2 { margin-bottom: 1.25rem; }
      .profile-overview { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; align-items: center; }
      .profile-overview p { display: flex; align-items: center; gap: 1rem; line-height: 1.4; }
      .profile-overview p + p { border-left: 1px solid var(--rule); padding-left: 1.5rem; }
      .profile-symbol { display: grid; place-items: center; flex-shrink: 0; width: 3.25rem; height: 3.25rem; border-radius: 1rem; background: #ede1fd; color: #652eb8; font-size: 1.5rem; font-weight: 600; }
      .text-link { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 2.75rem; font-size: 0.9375rem; }
      .profile-sources { margin-top: 1.25rem; scroll-margin-top: 0.5rem; }
      .profile-sources > summary { display: inline-flex; align-items: center; gap: 1rem; min-height: 2.75rem; color: var(--signal); cursor: pointer; list-style: none; text-decoration: underline; text-underline-offset: 0.25em; font-size: 0.875rem; }
      .profile-sources > summary::-webkit-details-marker, .ledger-disclosure::-webkit-details-marker { display: none; }
      .profile-sources[open] > summary span { transform: rotate(45deg); }
      .section-intro { color: var(--muted-ink); font-size: 0.875rem; }
      .profile-sources > .section-intro { padding-block: 1rem; max-width: 65ch; }
      .evidence-ledger { list-style: none; padding: 0; border-bottom: 1px solid var(--rule); }
      .evidence-ledger > li { border-top: 1px solid var(--rule); padding-bottom: 0.5rem; }
      .ledger-disclosure { display: grid; grid-template-columns: 2rem 1fr auto; gap: 0.75rem; align-items: center; min-height: 3.5rem; padding-block: 0.75rem; cursor: pointer; list-style: none; }
      .ledger-number { color: var(--signal); font-size: 0.75rem; }
      .ledger-capability { font-size: 1rem; line-height: 1.4; font-weight: 550; }
      .ledger-indicator { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; color: var(--signal); background: #ede1fd; border-radius: 50%; }
      details[open] .ledger-indicator::before { content: "−"; }
      details:not([open]) .ledger-indicator::before { content: "+"; }
      .ledger-details { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding: 0.75rem 2.5rem 1rem 2.75rem; }
      .ledger-field { display: grid; align-content: start; gap: 0.5rem; }
      dt { color: var(--muted-ink); font-size: 0.75rem; font-weight: 650; }
      dd { font-size: 0.875rem; overflow-wrap: anywhere; }
      .ledger-qualification dd { color: var(--muted-ink); }
      .ledger-source { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding-left: 2.75rem; font-size: 0.8125rem; }
      .ledger-source-label { color: var(--muted-ink); }
      .ledger-source a { display: inline-flex; align-items: center; min-height: 2.75rem; }
      #selected-evidence { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
      .section-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1rem; grid-column: 1 / -1; }
      #selected-evidence article { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 1.25rem; min-width: 0; padding: 1rem; border-radius: 1.25rem; background: var(--surface); }
      .project-study { display: flex; flex-direction: column; justify-content: center; padding: 0.8rem; border-radius: 0.8rem; background: #faf6ff; min-width: 0; }
      .project-study > span { font-size: 0.75rem; color: #6838a0; }
      .project-study svg { display: block; width: 100%; height: 9rem; }
      .project-copy { display: flex; flex-direction: column; gap: 0.6rem; justify-content: center; min-width: 0; padding-block: 0.5rem; }
      .project-copy h3 { font-size: clamp(1.375rem, 2vw, 1.875rem); line-height: 1.2; letter-spacing: -0.04em; overflow-wrap: anywhere; }
      .project-copy > p { color: var(--muted-ink); font-size: 0.875rem; }
      .project-copy .project-stack { font-size: 0.8125rem; }
      .project-link { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 0.3rem; min-height: 2.75rem; padding-top: 0.25rem; font-size: 0.875rem; }
      .work-scope { grid-column: 1 / -1; color: var(--muted-ink); font-size: 0.8125rem; max-width: 100ch; }
      #learning-archive { display: grid; grid-template-columns: auto 1fr auto; gap: 1.25rem; align-items: center; padding: 1.5rem; border-radius: 1rem; background: #f1eaff; }
      .archive-symbol { font-size: 2rem; color: #8b4ace; }
      #learning-archive h2 { font-size: 1.125rem; margin-bottom: 0.4rem; }
      #learning-archive p { max-width: 70ch; font-size: 0.8125rem; color: var(--muted-ink); }
      #contact-path { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rule); margin-bottom: 0; }
      .contact-intro { margin-top: 0.5rem; color: var(--muted-ink); font-size: 0.875rem; }
      #contact-path ul { display: flex; flex-wrap: wrap; gap: 1.5rem; list-style: none; padding: 0; }
      #contact-path a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; }
      .site-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding-block: 1rem; color: var(--muted-ink); font-size: 0.75rem; }
