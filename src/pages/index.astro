---
import EvidenceLedger from "../components/EvidenceLedger.svelte";
import FlabSculpture from "../components/FlabSculpture.svelte";
import SparseStars from "../components/SparseStars.svelte";
import SectionFooter from "../components/SectionFooter.astro";
import { FLAB_PATH, FLAB_FILL_RULE, FLAB_VIEWBOX } from "../lib/flabMark";

const githubProfile = "https://github.com/FlaBBB";
const linkedInProfile = "https://www.linkedin.com/in/fikri-flab/";
const email = "f12345ff67@gmail.com";
const ownerName = "Fikri Muhammad Abdillah";
const description =
  "Fikri Muhammad Abdillah’s Portfolio Site: explore TypeScript web and realtime projects, agentic SDLC tooling, and a security-learning archive through public source material.";

// Recognizable contact marks. They are decorative (aria-hidden); the adjacent
// text labels carry the accessible name.
const GITHUB_ICON =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
const LINKEDIN_ICON =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";

const profileRecords = [
  {
    capability: "TypeScript web applications",
    observedEvidence:
      "TypeScript web and realtime application structure is publicly visible across WordyChain, JMC, and the harness-agentic-sdlc workflow tooling.",
    qualification:
      "Public repositories establish hosted project material, not individual proficiency level, employment history, or sole authorship.",
    sources: [
      { name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" },
      { name: "JMC", href: "https://github.com/FlaBBB/JMC" },
      {
        name: "harness-agentic-sdlc",
        href: "https://github.com/FlaBBB/harness-agentic-sdlc",
      },
    ],
  },
  {
    capability: "Modular application design with automated tests",
    observedEvidence:
      "WordyChain visibly separates realtime and web applications from shared, dictionary, and game-core packages, with unit-flow, end-to-end, and package-level tests; OOT-AI-Agent-Practice pairs a Java store with JUnit 5 tests and a business-rule verifier.",
    qualification:
      "Visible project structure and tests do not establish authorship of every component.",
    sources: [
      { name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" },
      {
        name: "OOT-AI-Agent-Practice",
        href: "https://github.com/FlaBBB/OOT-AI-Agent-Practice",
      },
    ],
  },
  {
    capability: "Project-specific web-stack exposure",
    observedEvidence:
      "JMC documents Next.js App Router, TypeScript, PostgreSQL/Prisma, NextAuth.js v5, Tailwind CSS v4, Bun, Docker, Piston-backed code execution, and multiple submission languages.",
    qualification:
      "This is JMC’s documented stack, not a personal proficiency claim; the README says the project was written by AI.",
    sources: [{ name: "JMC", href: "https://github.com/FlaBBB/JMC" }],
  },
  {
    capability: "Agentic SDLC workflow tooling",
    observedEvidence:
      "harness-agentic-sdlc publishes a TypeScript CLI and repository-local governance: a request-to-deploy lifecycle, structured YAML workflows, approval and CI evidence, a Mission Control projection, and machine-readable JSON output.",
    qualification:
      "This describes the project’s documented capabilities, not verified personal authorship, adoption, or production use.",
    sources: [
      {
        name: "harness-agentic-sdlc",
        href: "https://github.com/FlaBBB/harness-agentic-sdlc",
      },
    ],
  },
  {
    capability: "Security-learning archive",
    observedEvidence:
      "A public cybersecurity archive spans cryptography, digital forensics, reverse engineering, binary exploitation, and smart-contract security, drawn from many CTF platforms and paired with supporting tools and cheatsheets.",
    qualification:
      "A learning archive, not professional security work, a certification, or production security responsibility.",
    sources: [
      {
        name: "Cybers_security",
        href: "https://github.com/FlaBBB/Cybers_security",
      },
    ],
  },
  {
    capability: "Reconciled professional and competition profile",
    observedEvidence:
      "The LinkedIn Source Profile lists an engineering role at Six Zenith Digital, study at Politeknik Negeri Malang, and active Capture The Flag participation; the linked CTFtime profile records competition teams and published writeups since 2023.",
    qualification:
      "Profile-stated and self-reported; not independently verified, and not a claim of seniority, employment terms, or professional security responsibility.",
    sources: [
      { name: "LinkedIn", href: linkedInProfile },
      { name: "CTFtime", href: "https://ctftime.org/user/156246" },
    ],
  },
];

const projects = [
  {
    id: "wordychain",
    index: "01",
    name: "WordyChain",
    deck: "Realtime and web boundaries, kept visible.",
    structureLabel: "Visible WordyChain packages",
    structure: ["web", "realtime", "shared", "dictionary", "game-core"],
    copy: "Public project structure separates realtime, web, shared, dictionary, and game-core packages; unit-flow, end-to-end, and package-level test directories are visible.",
    scopeNote:
      "Repository structure is evidence of visible project organization, not a claim of exclusive authorship.",
    href: "https://github.com/FlaBBB/WordyChain",
  },
  {
    id: "jmc",
    index: "02",
    name: "JMC",
    deck: "A documented web application stack.",
    structureLabel: "Documented JMC stack",
    structure: ["Next.js", "TypeScript", "PostgreSQL", "Prisma", "Docker"],
    copy: "JMC documents a Next.js and TypeScript application with PostgreSQL/Prisma, NextAuth.js, Tailwind CSS, Bun, Docker, and sandboxed multi-language code execution.",
    scopeNote:
      "This describes JMC’s documented stack. It does not assert individual authorship or proficiency; its README says the project was written by AI.",
    href: "https://github.com/FlaBBB/JMC",
  },
  {
    id: "harness",
    index: "03",
    name: "harness-agentic-sdlc",
    deck: "Workflow governance for agent-driven delivery.",
    structureLabel: "Documented harness-agentic-sdlc surface",
    structure: ["TypeScript", "CLI", "YAML workflows", "Mission Control", "JSON output"],
    copy: "A repository-local harness publishes a request-to-deploy lifecycle with structured workflows, approval and CI evidence, a Mission Control projection for multi-feature work, and machine-readable output.",
    scopeNote:
      "This describes the project’s documented capabilities, not verified personal authorship or production adoption.",
    href: "https://github.com/FlaBBB/harness-agentic-sdlc",
  },
];

const sections = [
  { id: "selected-evidence", label: "Work" },
  { id: "technical-profile", label: "Profile" },
  { id: "learning-archive", label: "Archive" },
  { id: "contact-path", label: "Contact" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>flab — Fikri Muhammad Abdillah</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17131e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="flab — Fikri Muhammad Abdillah" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://flab.my.id/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="flab — Fikri Muhammad Abdillah" />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://flab.my.id/" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        var reduced = false;
        try {
          reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        } catch (error) {
          reduced = false;
        }
        if (!reduced) root.classList.add("motion");
        window.setTimeout(function () {
          if (!window.__afterHoursMotionReady) root.classList.remove("motion", "js");
        }, 2000);
      })();
    </script>
  </head>
  <body>
    <SparseStars client:load />
    <!--
      Layering, bottom to top: the base plum background, the violet Contact
      surface (visible only while Contact is the settled scene), the original
      sampled particle sky, then the transparent scene screens. The sky stays
      behind every later section because it is a body-level fixed layer, outside
      the pinned stage's stacking context.
    -->
    <div class="contact-surface" aria-hidden="true"></div>
    <div class="sky-plane" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="flab-logo" href="#identity" aria-label="flab — back to Fikri Muhammad Abdillah’s identity">
        <svg viewBox={`0 0 ${FLAB_VIEWBOX.width} ${FLAB_VIEWBOX.height}`} aria-hidden="true">
          <path d={FLAB_PATH} fill="currentColor" fill-rule={FLAB_FILL_RULE} />
        </svg>
      </a>
      <nav aria-label="Portfolio sections">
        <ol>
          {sections.map(({ id, label }) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ol>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <!-- One tall flow element supplies the native scroll budget; the sticky
           stage is pinned inside it and the controller scrubs the scene stack
           from a single global progress. -->
      <div class="journey" data-journey>
        <div class="stage" data-stage>
        <section id="identity" class="scene" data-scene="identity" aria-label="Identity">
          <FlabSculpture client:media="(prefers-reduced-motion: no-preference)" />
        </section>

        <section id="intro" class="scene" data-scene="intro" aria-labelledby="intro-heading">
          <div class="section-content">
          <div class="intro-layout">
            <div class="intro-lead">
              <h1 id="intro-heading">Fikri Muhammad Abdillah<span class="intro-dot" aria-hidden="true">.</span></h1>
              <p class="intro-secondary">Web applications. Realtime systems.</p>
            </div>
            <div class="intro-body">
              <p class="intro-note" data-reveal>
                Based in Malang, Indonesia, my focus is TypeScript across web and realtime
                applications and agentic workflow tooling, with the public repositories in
                that space open to read.
              </p>
              <p class="intro-note intro-note-soft" data-reveal>
                Capture the flag is where I keep learning — cryptography, digital forensics,
                reverse engineering, binary exploitation and smart-contract security — kept
                as notes rather than presented as professional security work.
              </p>
              <a class="intro-link" href="#selected-evidence" data-reveal>
                Selected work <span aria-hidden="true">↓</span>
              </a>
            </div>
          </div>
          </div>
          <SectionFooter name={ownerName} year={year} />
        </section>

        <section id="selected-evidence" class="scene" data-scene="selected-evidence" aria-labelledby="selected-evidence-heading">
          <div class="section-content">
          <div class="work-layout">
            <div class="work-intro">
              <p class="eyebrow">01 / Work</p>
              <h2 id="selected-evidence-heading" data-reveal>Look inside the work.</h2>
              <p class="section-intro" data-reveal>
                Three public repositories. Different systems, with the source material open to
                inspection.
              </p>
            </div>
            <ol class="work-index">
              {projects.map((project) => (
                <li data-reveal>
                  <article aria-labelledby={`${project.id}-heading`}>
                    <p class="project-index" aria-hidden="true">{project.index}</p>
                    <div class="project-body">
                      <h3 id={`${project.id}-heading`}>{project.name}</h3>
                      <p class="project-deck">{project.deck}</p>
                      <div class="project-structure" aria-label={project.structureLabel}>
                        {project.structure.map((item) => <span>{item}</span>)}
                      </div>
                      <p class="project-copy">{project.copy}</p>
                      <p class="scope-note">{project.scopeNote}</p>
                      <a class="project-link" href={project.href}>Source: {project.name} <span aria-hidden="true">↗</span></a>
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </div>
          </div>
          <SectionFooter name={ownerName} year={year} />
        </section>

        <section id="technical-profile" class="scene" data-scene="technical-profile" aria-labelledby="technical-profile-heading">
          <div class="section-content">
          <div class="section-heading">
            <p class="eyebrow">02 / Profile</p>
            <h2 id="technical-profile-heading" data-reveal>Evidence over claims.</h2>
            <p class="section-intro" data-reveal>
              A curated record of publicly visible projects and learning material. Open a record
              for the evidence and its limits.
            </p>
          </div>
          <EvidenceLedger records={profileRecords} />
          </div>
          <SectionFooter name={ownerName} year={year} />
        </section>

        <section id="learning-archive" class="scene" data-scene="learning-archive" aria-labelledby="learning-archive-heading">
          <div class="section-content archive-content">
          <div class="section-heading">
            <p class="eyebrow">03 / Archive</p>
            <h2 id="learning-archive-heading" data-reveal>Still learning. Keeping the notes.</h2>
          </div>
          <div class="archive-layout">
            <p class="archive-statement" data-reveal>
              A public CTF-oriented archive spans cryptography, digital forensics, reverse
              engineering, binary exploitation, and smart-contract security.
            </p>
            <div class="archive-aside">
              <p class="archive-detail" data-reveal>
                Drawn from many competition platforms and paired with supporting tools and
                cheatsheets.
              </p>
              <p class="scope-note" data-reveal>Learning material, not professional security experience.</p>
              <div class="archive-links">
                <a class="text-link" href="https://github.com/FlaBBB/Cybers_security" data-reveal>
                  Inspect Cybers_security <span aria-hidden="true">↗</span>
                </a>
                <a class="text-link" href="https://ctftime.org/user/156246" data-reveal>
                  Competition record on CTFtime <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
          </div>
          <SectionFooter name={ownerName} year={year} />
        </section>

        <section id="contact-path" class="scene" data-scene="contact-path" aria-labelledby="contact-path-heading">
          <div class="section-content">
          <div class="contact-layout">
            <div class="contact-intro-block">
              <p class="eyebrow">04 / Contact</p>
              <h2 id="contact-path-heading" data-reveal>Let’s talk.</h2>
              <p class="contact-intro" data-reveal>
                Explore the source, connect on LinkedIn, or send a note directly.
              </p>
            </div>
            <ul class="contact-paths">
              <li data-reveal>
                <a href={githubProfile}>
                  <span class="contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d={GITHUB_ICON} /></svg>
                  </span>
                  <span class="contact-label"><strong>GitHub</strong><span>Inspect public work</span></span>
                  <span class="contact-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
              <li data-reveal>
                <a href={linkedInProfile}>
                  <span class="contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d={LINKEDIN_ICON} /></svg>
                  </span>
                  <span class="contact-label"><strong>LinkedIn</strong><span>Professional profile</span></span>
                  <span class="contact-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
              <li data-reveal>
                <!--email_off--><a href={`mailto:${email}`}>
                  <span class="contact-icon contact-icon-envelope" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
                      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
                    </svg>
                  </span>
                  <span class="contact-label"><strong>Email</strong><span>Start a conversation</span></span>
                  <span class="contact-arrow" aria-hidden="true">↗</span>
                </a><!--/email_off-->
              </li>
            </ul>
          </div>
          </div>
          <SectionFooter name={ownerName} year={year} />
        </section>
        </div>
      </div>
    </main>

    <style is:global>
      :root {
        --background: #17131e;
        --surface: #1f1929;
        --ink: #ece8f4;
        --muted-ink: #a89fb8;
        --rule: #2f2839;
        --accent: #a78bfa;
        --accent-strong: #7c5cf5;
        --accent-ink: #d9cffb;
        /* Open contact band: light violet surface with plum ink (6.7:1). */
        --contact-band: #a78bfa;
        --contact-ink: #1b1430;
        --gutter: clamp(1.25rem, 5vw, 5rem);
        --font-sans:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue",
          Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        color-scheme: dark;
        font-family: var(--font-sans);
        font-synthesis: none;
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: var(--background);
        scroll-behavior: smooth;
        scroll-padding-top: 0;
      }
      body {
        margin: 0;
        background: var(--background);
        color: var(--ink);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3,
      p,
      ol,
      ul,
      dl,
      dd {
        margin: 0;
      }
      a {
        color: inherit;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25em;
      }
      a,
      summary {
        -webkit-tap-highlight-color: transparent;
      }
      a:focus-visible,
      summary:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }
      /* The contact band is violet, so the default accent outline would be
         invisible on it; use the band's own ink for a contrasting ring. */
      #contact-path a:focus-visible {
        outline-color: var(--contact-ink);
      }
      main:focus {
        outline: none;
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: var(--gutter);
        z-index: 20;
        padding: 0.75rem 1rem;
        color: var(--background);
        background: var(--accent);
        border-radius: 999px;
        transform: translateY(-200%);
      }
      .skip-link:focus {
        transform: translateY(0);
      }
      .eyebrow {
        color: var(--muted-ink);
        font: 500 0.75rem/1.5 var(--font-mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      /* Header */
      /* Fixed rather than sticky: the opening is genuinely full viewport, so the
         header overlays it instead of pushing the sculpture down. */
      .site-header {
        --header-ink: var(--ink);
        --header-muted: var(--muted-ink);
        position: fixed;
        inset: 0 0 auto;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.1rem var(--gutter);
      }
      .site-header[data-contact="true"] {
        --header-ink: var(--contact-ink);
        --header-muted: var(--contact-ink);
      }
      .site-header[data-contact="true"] a:focus-visible {
        outline-color: var(--contact-ink);
      }
      /* While the Contact surface is mid-blend the composited backdrop passes
         through a mid luminance where neither the dark-scene ink nor the plum
         Contact ink clears 4.5:1, so the foreground switches to whichever of
         white/black keeps the greater contrast against the actual colour. The
         normal palette is restored at the stable endpoints (0.000 and 1.000). */
      .site-header[data-contact-phase="contact"] {
        --header-ink: var(--contact-ink);
        --header-muted: var(--contact-ink);
      }
      .site-header[data-contact-phase="contact"] a:focus-visible {
        outline-color: var(--contact-ink);
      }
      .site-header[data-contact-phase="blend"] {
        --header-ink: #ffffff;
        --header-muted: #ffffff;
      }
      .site-header[data-contact-phase="blend"] a:focus-visible {
        outline-color: #ffffff;
      }
      .site-header[data-contact-phase="blend"][data-contact-ink="dark"] {
        --header-ink: #000000;
        --header-muted: #000000;
      }
      .site-header[data-contact-phase="blend"][data-contact-ink="dark"] a:focus-visible {
        outline-color: #000000;
      }
      html:not(.js) .site-header {
        position: absolute;
      }
      .flab-logo {
        display: inline-flex;
        align-items: center;
        color: var(--header-ink);
        flex-shrink: 0;
        transition: color 180ms ease;
      }
      .flab-logo:hover {
        color: var(--header-ink);
      }
      .flab-logo svg {
        width: 3.75rem;
        height: auto;
        display: block;
      }
      nav {
        min-width: 0;
      }
      nav ol {
        display: flex;
        align-items: center;
        gap: clamp(0.75rem, 2vw, 2rem);
        padding: 0;
        list-style: none;
      }
      nav a {
        display: inline-flex;
        align-items: center;
        min-height: 2.8125rem;
        white-space: nowrap;
        color: var(--header-muted);
        font-size: 0.9375rem;
        text-decoration: none;
        transition: color 180ms ease;
      }
      nav a:hover {
        color: var(--header-ink);
      }

      /* Default: an ordinary, fully readable document. Every scene is in flow
         with its natural height and its own footer at the bottom, so no-JS, an
         aborted module and reduced motion always expose the whole page. */
      .journey {
        position: relative;
        width: 100%;
      }
      .scene {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-height: 100svh;
        background: var(--background);
      }
      .scene > .section-content {
        flex: 1;
      }
      /* Opt-in pinned presentation, activated only after setup succeeds without
         a reduced-motion preference. The sticky stage scrubs the scene stack
         from one global progress; nothing snaps or traps input. */
      .journey[data-active="true"] .stage {
        position: sticky;
        top: 0;
        z-index: 2;
        height: 100vh;
        height: 100svh;
        /* clip, not hidden: it clips presentation without creating an inner
           scroll container that focus/fragment navigation could offset. */
        overflow: clip;
      }
      .journey[data-active="true"] .scene {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        background: transparent;
        will-change: transform;
      }
      /* In the pinned presentation the violet is the fixed surface, so the
         Contact scene itself is transparent and the stars show through it. */
      .journey[data-active="true"] #contact-path {
        background: transparent;
      }
      /* Mid-blend foreground: the stage's palette tokens switch to whichever of
         white/black keeps the greater contrast against the actual composited
         surface, covering the incoming Contact copy and the outgoing Archive
         footer (which inherits --muted-ink). Scoped to the stage so the fixed
         particle plane outside it keeps its own colours. */
      .journey[data-active="true"] .stage[data-contact-phase="blend"] {
        --ink: #ffffff;
        --muted-ink: #ffffff;
        --contact-ink: #ffffff;
        --accent: #ffffff;
        --accent-ink: #ffffff;
        --rule: rgba(255, 255, 255, 0.35);
      }
      .journey[data-active="true"] .stage[data-contact-phase="blend"][data-contact-ink="dark"] {
        --ink: #000000;
        --muted-ink: #000000;
        --contact-ink: #000000;
        --accent: #000000;
        --accent-ink: #000000;
        --rule: rgba(0, 0, 0, 0.35);
      }
      /* The polarity can flip mid-blend; a colour transition would tween the
         foreground through an unreadable gray, so only the colour channel is
         dropped here. Background, border and transform keep their existing
         timing so hover and nudge behaviour is unchanged. Each selector mirrors
         the no-preference transition rule with the blend ancestor and carries
         the same ID, so it also wins for #contact-path anchors, whose rule
         otherwise outranks a class-only override. */
      .site-header[data-contact-phase="blend"] nav a,
      .site-header[data-contact-phase="blend"] .flab-logo,
      .journey[data-active="true"] .stage[data-contact-phase="blend"] .intro-link,
      .journey[data-active="true"] .stage[data-contact-phase="blend"] .project-link,
      .journey[data-active="true"] .stage[data-contact-phase="blend"] .text-link,
      .journey[data-active="true"] .stage[data-contact-phase="blend"] .ledger-source a,
      .journey[data-active="true"] .stage[data-contact-phase="blend"] #contact-path a,
      .journey[data-active="true"] .stage[data-contact-phase="blend"] .site-footer a {
        transition-property: background-color, border-color, transform;
      }
      /* The violet Contact surface sits below the fixed particle sky, so the
         original stars stay visible over it. It is driven by the global
         timeline, not an independent timer. */
      .contact-surface {
        position: fixed;
        inset: 0;
        z-index: 0;
        background: var(--contact-band);
        opacity: 0;
        pointer-events: none;
      }
      /* The persistent sky sits above every scene surface and below all
         content, footer and nav. Fixed and outside the pinned stage, so the
         stage's stacking context can never bury it. */
      .sky-plane {
        position: fixed;
        inset: 0;
        z-index: 1;
        overflow: hidden;
        pointer-events: none;
      }
      .section-content {
        position: relative;
        z-index: 2;
        display: grid;
        align-content: center;
        width: 100%;
        max-width: 108rem;
        margin-inline: auto;
        padding: max(6.5rem, 10svh) var(--gutter) clamp(3rem, 6svh, 6rem);
      }
      .section-heading {
        display: grid;
        gap: 1rem;
        max-width: 52rem;
        margin-bottom: 3.5rem;
      }
      h2 {
        font-size: clamp(2.25rem, 5vw, 4.25rem);
        font-weight: 700;
        line-height: 1.02;
        letter-spacing: -0.045em;
      }
      .section-intro {
        max-width: 48ch;
        color: var(--muted-ink);
      }

      /* Opening: one viewport, dispersing during the transition to Intro. */
      #identity {
        padding: 0;
      }

      /* Intro: a fuller, human first-person statement, still not a second hero. */
      .intro-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 2.5rem 4.5rem;
        align-items: center;
      }
      .intro-lead {
        display: grid;
        gap: 1rem;
      }
      h1 {
        font-size: clamp(2.5rem, 5.5vw, 4.5rem);
        font-weight: 700;
        line-height: 0.98;
        letter-spacing: -0.05em;
      }
      .intro-dot {
        color: var(--accent);
      }
      .intro-secondary {
        font-size: clamp(1.25rem, 2.2vw, 1.75rem);
        font-weight: 500;
        letter-spacing: -0.02em;
      }
      .intro-body {
        display: grid;
        gap: 1.25rem;
        justify-items: start;
      }
      .intro-note {
        max-width: 46ch;
        color: var(--ink);
        font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
        line-height: 1.6;
      }
      .intro-note-soft {
        color: var(--muted-ink);
        font-size: clamp(1rem, 1.3vw, 1.125rem);
      }
      .intro-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.8125rem;
        margin-top: 0.25rem;
        color: var(--accent-ink);
        text-decoration: none;
      }
      .intro-link:hover {
        text-decoration: underline;
      }

      /* Work index: narrow editorial intro beside stacked projects. */
      .work-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
        gap: 2.5rem 4rem;
        align-items: start;
      }
      .work-intro {
        position: sticky;
        top: 6.5rem;
        display: grid;
        gap: 0.85rem;
      }
      .work-intro .section-intro {
        max-width: 30ch;
      }
      .work-index {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 0;
      }
      .work-index > li {
        border-top: 1px solid var(--rule);
      }
      .work-index article {
        display: grid;
        grid-template-columns: 3.5rem 1fr;
        gap: 1rem 1.5rem;
        padding: 2.25rem 0;
      }
      .project-index {
        color: var(--muted-ink);
        font: 500 0.875rem/1.6 var(--font-mono);
      }
      .project-body {
        display: grid;
        gap: 1rem;
        min-width: 0;
      }
      .project-body h3 {
        font-size: clamp(1.75rem, 3.6vw, 2.75rem);
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -0.035em;
        overflow-wrap: anywhere;
      }
      .project-deck {
        color: var(--ink);
        font-size: 1.0625rem;
      }
      .project-structure {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .project-structure span {
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--rule);
        border-radius: 999px;
        color: var(--muted-ink);
        font: 0.75rem/1.4 var(--font-mono);
      }
      .project-copy {
        max-width: 62ch;
        color: var(--muted-ink);
      }
      .scope-note {
        max-width: 62ch;
        padding-left: 1rem;
        border-left: 2px solid var(--rule);
        color: var(--muted-ink);
        font-size: 0.875rem;
      }
      .project-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.8125rem;
        color: var(--accent-ink);
        justify-self: start;
      }
      .project-link:hover {
        text-decoration: underline;
      }

      /* Evidence ledger */
      .evidence-ledger {
        list-style: none;
        padding: 0;
      }
      .evidence-ledger > li {
        border-top: 1px solid var(--rule);
        padding-bottom: 0.5rem;
      }
      .ledger-disclosure {
        display: grid;
        grid-template-columns: 2.5rem 1fr;
        gap: 1rem;
        align-items: center;
        min-height: 4.5rem;
        padding: 1.25rem 0 0.75rem;
        cursor: pointer;
        list-style: none;
      }
      .ledger-disclosure::-webkit-details-marker {
        display: none;
      }
      .ledger-number {
        color: var(--muted-ink);
        font: 0.75rem/1.5 var(--font-mono);
      }
      .ledger-capability {
        font-size: clamp(1.125rem, 1.8vw, 1.4rem);
        letter-spacing: -0.02em;
        line-height: 1.3;
      }
      .evidence-ledger > li:hover .ledger-capability,
      .evidence-ledger details[open] .ledger-capability {
        color: var(--accent-ink);
      }
      .ledger-details {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: 2rem 3rem;
        padding: 0.5rem 3rem 1.5rem 3.5rem;
      }
      .ledger-field {
        display: grid;
        align-content: start;
        gap: 0.5rem;
      }
      dt {
        color: var(--muted-ink);
        font: 500 0.6875rem/1.5 var(--font-mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      dd {
        font-size: 0.9375rem;
        overflow-wrap: anywhere;
      }
      .ledger-qualification dd {
        color: var(--muted-ink);
      }
      .ledger-source {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.25rem;
        padding-left: 3.5rem;
      }
      .ledger-source-label {
        color: var(--muted-ink);
        font: 0.6875rem/1.5 var(--font-mono);
        text-transform: uppercase;
      }
      .ledger-source a {
        display: inline-flex;
        align-items: center;
        min-height: 2.8125rem;
        color: var(--accent-ink);
        font-size: 0.875rem;
      }

      /* Archive: a heavier statement beside its supporting notes, so the copy
         never stretches into one very long line on wide screens. */
      .archive-content {
        max-width: 98rem;
      }
      .archive-content .section-heading {
        max-width: none;
        margin-bottom: clamp(2rem, 4svh, 3rem);
      }
      .archive-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 2rem clamp(2rem, 4vw, 4rem);
        align-items: center;
      }
      .archive-statement {
        max-width: 32ch;
        font-size: clamp(1.5rem, 3vw, 2.375rem);
        font-weight: 600;
        line-height: 1.14;
        letter-spacing: -0.03em;
        text-wrap: pretty;
      }
      .archive-aside {
        display: grid;
        gap: 1.25rem;
        justify-items: start;
      }
      .archive-detail {
        max-width: 40ch;
        color: var(--muted-ink);
        font-size: 1rem;
      }
      .archive-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
      }
      .text-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.8125rem;
        color: var(--accent-ink);
      }
      .text-link:hover {
        text-decoration: underline;
      }

      /* Contact: an open violet band with plum ink and adjacent paths. */
      #contact-path {
        background: var(--contact-band);
        color: var(--contact-ink);
      }
      .contact-layout {
        display: grid;
        gap: clamp(2.5rem, 7svh, 5rem);
      }
      #contact-path .eyebrow {
        color: var(--contact-ink);
      }
      #contact-path h2 {
        margin-top: 0.75rem;
        font-size: clamp(3rem, 8vw, 7rem);
        font-weight: 800;
        line-height: 0.94;
        letter-spacing: -0.05em;
      }
      .contact-intro {
        margin-top: 1.25rem;
        max-width: 34ch;
        font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
        color: var(--contact-ink);
      }
      .contact-paths {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid color-mix(in srgb, var(--contact-ink) 26%, transparent);
        padding: 1.5rem 0 0;
        list-style: none;
      }
      .contact-paths li + li {
        border-left: 1px solid color-mix(in srgb, var(--contact-ink) 26%, transparent);
        padding-left: 1.75rem;
      }
      .contact-paths a {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.35rem 1rem;
        min-height: 6.5rem;
        padding-top: 1.25rem;
        /* Optical inset for the trailing arrow: without it the arrow sits on the
           column's right edge, touching the next column's separator. 1.25rem
           leaves >=16px even during the 4px hover nudge. */
        padding-inline-end: 1.25rem;
        text-decoration: none;
      }
      .contact-icon {
        grid-column: 1 / -1;
        display: inline-flex;
        align-items: center;
        /* Uniform optical slot: the stroked envelope is taller than the filled
           brand marks, so without a shared slot its label row sits ~4px lower. */
        height: 1.75rem;
        color: var(--contact-ink);
      }
      .contact-icon svg {
        width: 1.5rem;
        height: 1.5rem;
        display: block;
      }
      /* The stroked envelope covers less optical area than the 24px filled brand
         marks, so it gets a small size correction to sit level with them. */
      .contact-icon-envelope svg {
        width: 1.75rem;
        height: 1.75rem;
      }
      .contact-label {
        display: grid;
        gap: 0.15rem;
      }
      .contact-paths strong {
        font-size: 1.125rem;
        font-weight: 600;
      }
      .contact-label > span {
        color: var(--contact-ink);
        font-size: 0.875rem;
      }
      .contact-arrow {
        font-size: 1.125rem;
      }
      .contact-paths a:hover strong {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      /* A quiet text-only signature on each section's own surface. */
      .site-footer {
        position: relative;
        z-index: 2;
        flex-shrink: 0;
        padding-block: 0.75rem;
        color: var(--muted-ink);
        font: 400 0.75rem/1.6 var(--font-mono);
        letter-spacing: 0.02em;
      }
      #contact-path .site-footer {
        color: var(--contact-ink);
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 2rem;
        max-width: 108rem;
        margin-inline: auto;
        padding-inline: var(--gutter);
      }
      .footer-identity {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      .footer-sep {
        color: inherit;
      }
      /* Still learning remains a keyboard/touch-friendly back-to-top link. */
      .footer-top {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        color: inherit;
        text-decoration: none;
      }
      .footer-top:hover .footer-note {
        text-decoration: underline;
        text-underline-offset: 0.25em;
      }

      @media (max-width: 900px) {
        .work-layout,
        .intro-layout,
        .archive-layout {
          grid-template-columns: 1fr;
        }
        .intro-layout {
          align-items: start;
          gap: 1.5rem;
        }
        .archive-layout {
          gap: 1.75rem;
        }
        .archive-statement {
          max-width: 34ch;
        }
        .work-intro {
          position: static;
        }
        .work-intro .section-intro {
          max-width: 48ch;
        }
        .ledger-details {
          grid-template-columns: 1fr;
        }
        .ledger-details {
          gap: 1.5rem;
          padding-right: 0;
        }
      }
      @media (max-width: 640px) {
        .site-header {
          padding-inline: var(--gutter);
          /* Narrower header gap: at 320px the logo plus four nowrap labels only
             fit once this shrinks. Wider system fonts (e.g. DejaVu Sans on
             Linux CI) need the extra room. */
          gap: 1rem;
        }
        .section-content {
          padding-block: 6rem 3rem;
        }
        .flab-logo svg {
          width: 3rem;
        }
        nav ol {
          gap: 0.9rem;
        }
        nav a {
          font-size: 0.875rem;
        }
        .ledger-disclosure {
          grid-template-columns: 1.5rem 1fr;
          gap: 0.75rem;
        }
        .ledger-details,
        .ledger-source {
          padding-left: 2.25rem;
        }
        .work-index article {
          grid-template-columns: 2.25rem 1fr;
          gap: 0.5rem 1rem;
        }
        .contact-paths {
          grid-template-columns: 1fr;
          padding-top: 0;
        }
        /* Mobile stacks the three paths as rows, with a horizontal rule instead
           of the desktop vertical separators. */
        .contact-paths li + li {
          border-left: 0;
          border-top: 1px solid color-mix(in srgb, var(--contact-ink) 26%, transparent);
          padding-left: 0;
        }
        .contact-paths a {
          grid-template-columns: auto minmax(0, 1fr) auto;
          min-height: 4.5rem;
          padding-block: 0.75rem;
        }
        .contact-icon {
          grid-column: auto;
          height: auto;
        }
        .contact-icon-envelope svg {
          width: 1.5rem;
          height: 1.5rem;
        }
        .site-footer {
          padding-block: 1rem;
        }
        .footer-inner {
          gap: 0.5rem 1rem;
        }
        .footer-top {
          min-height: 2.75rem;
        }
      }

      .motion [data-reveal] {
        opacity: 0;
        transform: translateY(1.25rem);
      }
      @media (prefers-reduced-motion: no-preference) {
        nav a,
        .flab-logo,
        .intro-link,
        .project-link,
        .text-link,
        .ledger-source a,
        #contact-path a,
        .site-footer a {
          transition:
            color 180ms ease,
            background-color 180ms ease,
            border-color 180ms ease,
            transform 180ms ease;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>

    <script>
      import gsap from "gsap";
      // One-shot tweens follow wall time through dropped frames; the sky has its
      // own clock.
      gsap.ticker.lagSmoothing(0);
      import { setupEvidenceLedger } from "../lib/evidenceLedger";
      import { setupSectionScroll } from "../lib/sectionScroll";

      declare global {
        interface Window {
          __afterHoursMotionReady?: boolean;
        }
      }

      const root = document.documentElement;
      root.classList.add("js");
      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealTargets = gsap.utils.toArray<HTMLElement>("[data-reveal]");
      const nudgeLinks = gsap.utils.toArray<HTMLElement>(
        ".intro-link, .project-link, .text-link, .ledger-source a, .site-footer a, #contact-path a",
      );
      // The nudge animates the trailing arrow when a link has one, so the arrow
      // is what must be cleaned up when motion is switched off. Contact links
      // also carry a decorative icon span, so the arrow is named explicitly.
      const arrowOf = (element: HTMLElement) =>
        element.querySelector<HTMLElement>(".contact-arrow") ??
        element.querySelector<HTMLElement>('span[aria-hidden="true"]');
      const nudgeTargets = nudgeLinks.map(
        (element) => arrowOf(element) ?? element,
      );

      let active = false;
      let revealObserver: IntersectionObserver | undefined;
      // Retain each grouped reveal so teardown explicitly cancels every
      // delivery, including groups that overlap within the reveal window.
      let revealTweens: gsap.core.Tween[] = [];
      // Live reveal groups and the wall-clock instant each one should have
      // finished naturally. The GSAP ticker samples its time once per tick and a
      // slow renderer can delay the dispatch of that sample, so a group can
      // still show partial foreground state after its real deadline has passed.
      // This records the original deadline at creation and completes an overdue
      // group after the ticker has dispatched the whole frame, before the
      // browser paints it.
      const revealDeadlines = new Map<gsap.core.Tween, number>();
      function flushOverdueReveals() {
        // A queued check must never revive styles that teardown just cleared.
        if (!active) return;
        const now = performance.now();
        for (const [tween, deadline] of revealDeadlines) {
          // A group removed from its timeline has been killed (focus settle or
          // teardown) or has already finished; either way it needs no
          // correction. A freshly created tween still has a parent even before
          // its first tick, so it is never discarded here.
          if (!tween.parent) {
            revealDeadlines.delete(tween);
            continue;
          }
          if (now >= deadline) {
            tween.totalProgress(1);
            revealDeadlines.delete(tween);
          }
        }
        if (revealDeadlines.size === 0) gsap.ticker.remove(queueRevealFlush);
      }
      function queueRevealFlush() {
        // Run after the shared ticker has dispatched every listener, regardless
        // of listener order, but still inside the frame the browser is about to
        // paint.
        queueMicrotask(flushOverdueReveals);
      }
      let focusInHandler: ((event: Event) => void) | undefined;
      let scrollHandler: (() => void) | undefined;
      let scrollFrame = 0;

      function settle(targets: HTMLElement[]) {
        // Cancel any in-flight reveal first: otherwise a running opacity/y tween
        // repaints its earlier pose on the next frame, undoing this settlement.
        gsap.killTweensOf(targets, "opacity,y");
        gsap.set(targets, { opacity: 1, y: 0 });
      }

      function stopMotion() {
        revealObserver?.disconnect();
        revealObserver = undefined;
        if (focusInHandler) document.removeEventListener("focusin", focusInHandler);
        if (scrollHandler) {
          window.removeEventListener("scroll", scrollHandler);
          window.removeEventListener("hashchange", scrollHandler);
        }
        if (scrollFrame) cancelAnimationFrame(scrollFrame);
        focusInHandler = undefined;
        scrollHandler = undefined;
        scrollFrame = 0;
        // Stop the grouped reveals before clearing their inline styles.
        for (const tween of revealTweens) tween.kill();
        revealTweens = [];
        revealDeadlines.clear();
        gsap.ticker.remove(queueRevealFlush);
        gsap.killTweensOf([...revealTargets, ...nudgeTargets]);
        gsap.set(nudgeTargets, { clearProps: "transform" });
        root.classList.remove("motion");
        gsap.set(revealTargets, { clearProps: "all" });
        active = false;
      }

      function startMotion() {
        if (active) return;
        active = true;
        root.classList.add("motion");

        if (revealTargets.length) {
          revealObserver = new IntersectionObserver(
            (entries) => {
              // A queued callback can still be delivered after stopMotion ran
              // (e.g. a preference change mid-scroll). Starting a reveal tween
              // then would repaint hidden/offset state the settle just cleared.
              if (!active) return;
              const entering = entries
                .filter((entry) => entry.isIntersecting)
                .map((entry) => entry.target as HTMLElement);
              for (const target of entering) revealObserver?.unobserve(target);
              if (!entering.length) return;
              gsap.killTweensOf(entering, "opacity,y");
              const tween = gsap.to(entering, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                stagger: 0.06,
              });
              revealTweens.push(tween);
              revealDeadlines.set(
                tween,
                performance.now() + tween.totalDuration() * 1000,
              );
              if (revealDeadlines.size === 1) gsap.ticker.add(queueRevealFlush);
            },
            { rootMargin: "0px 0px -10% 0px" },
          );
          for (const target of revealTargets) revealObserver.observe(target);
        }

        focusInHandler = (event) => {
          const node = event.target;
          if (!(node instanceof Element)) return;
          const target = node.closest<HTMLElement>("[data-reveal]");
          if (target) settle([target]);
        };
        document.addEventListener("focusin", focusInHandler);

        // IntersectionObserver computes intersections on rendering frames, so a
        // fast scroll, an instant jump, or a deep-link landing can pass an
        // element without it ever being reported as intersecting. Anything
        // already scrolled past the viewport is settled here, so no target can
        // stay permanently hidden.
        const settlePassed = () => {
          const passed = revealTargets.filter(
            (target) =>
              Number(getComputedStyle(target).opacity) < 1 &&
              target.getBoundingClientRect().bottom <= 0,
          );
          if (!passed.length) return;
          for (const target of passed) revealObserver?.unobserve(target);
          settle(passed);
        };

        scrollHandler = () => {
          if (scrollFrame) return;
          scrollFrame = requestAnimationFrame(() => {
            scrollFrame = 0;
            settlePassed();
          });
        };
        window.addEventListener("scroll", scrollHandler, { passive: true });
        // A deep link may have scrolled before this module ran, so sweep once.
        requestAnimationFrame(settlePassed);
        window.addEventListener("hashchange", scrollHandler);
      }

      for (const element of nudgeLinks) {
        const arrow = arrowOf(element);
        const nudge = (direction: number) => {
          if (!active) return;
          gsap.to(arrow ?? element, {
            x: direction * 4,
            duration: 0.22,
            ease: "power2.out",
            overwrite: "auto",
          });
        };
        element.addEventListener("pointerenter", () => nudge(1));
        element.addEventListener("pointerleave", () => nudge(0));
        element.addEventListener("focus", () => nudge(1));
        element.addEventListener("blur", () => nudge(0));
      }

      const sceneEls = gsap.utils.toArray<HTMLElement>("[data-scene]");
      const foregroundOf = (scene: HTMLElement) =>
        scene.querySelectorAll<HTMLElement>(".section-content, .site-footer");
      // Runs after the controller applies its transforms, so outgoing copy can
      // never pass under the transparent fixed nav. Every scene is clipped to
      // the header; only foreground/footer are clipped, never the sky. This is
      // clipping only: exposing a focused control's ring is the one-shot job of
      // the controller's focus placement, so ordinary reading scroll is never
      // undone here.
      const syncForeground = () => {
        const headerBottom = document
          .querySelector<HTMLElement>(".site-header")!
          .getBoundingClientRect().bottom;
        for (const scene of sceneEls) {
          foregroundOf(scene).forEach((element) => {
            const box = element.getBoundingClientRect();
            const cut =
              box.bottom <= 0
                ? 0
                : Math.max(0, Math.min(box.height, headerBottom - box.top));
            const clip = cut > 0 ? `inset(${cut}px 0 0)` : "";
            if (element.style.clipPath !== clip) element.style.clipPath = clip;
          });
        }
      };

      // The controller is created first so the ledger can use its hold-aware
      // read placement when a disclosure relayout must preserve the chosen row.
      const scroll = setupSectionScroll(syncForeground);
      const destroyLedger = setupEvidenceLedger(scroll.preserveRead);
      window.addEventListener("pagehide", (event) => {
        if (event.persisted) return;
        destroyLedger();
        scroll.destroy();
        stopMotion();
      });

      function syncMotionPreference() {
        if (motionQuery.matches) {
          if (active) stopMotion();
          return;
        }
        startMotion();
      }

      motionQuery.addEventListener("change", syncMotionPreference);
      syncMotionPreference();
      window.__afterHoursMotionReady = true;
    </script>
  </body>
</html>
