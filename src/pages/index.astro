---
import EvidenceLedger from "../components/EvidenceLedger.svelte";
import FlabSculpture from "../components/FlabSculpture.svelte";
import { FLAB_PATH, FLAB_FILL_RULE, FLAB_VIEWBOX } from "../lib/flabMark";

const githubProfile = "https://github.com/FlaBBB";
const linkedInProfile = "https://www.linkedin.com/in/fikri-flab/";
const email = "f12345ff67@gmail.com";
const description =
  "Fikri Flab’s Portfolio Site: explore TypeScript web and realtime projects, agentic SDLC tooling, and a security-learning archive through public source material.";

const profileRecords = [
  {
    capability: "TypeScript web applications",
    observedEvidence:
      "TypeScript web and realtime application structure is publicly visible across WordyChain, JMC, and the harness-agentic-sdlc workflow tooling.",
    qualification:
      "Public repositories establish hosted project material, not individual proficiency level, employment history, or sole authorship.",
    sources: [
      { name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" },
      { name: "JMC", href: "https://github.com/FlaBBB/JMC" },
      {
        name: "harness-agentic-sdlc",
        href: "https://github.com/FlaBBB/harness-agentic-sdlc",
      },
    ],
  },
  {
    capability: "Modular application design with automated tests",
    observedEvidence:
      "WordyChain visibly separates realtime and web applications from shared, dictionary, and game-core packages, with unit-flow, end-to-end, and package-level tests; OOT-AI-Agent-Practice pairs a Java store with JUnit 5 tests and a business-rule verifier.",
    qualification:
      "Visible project structure and tests do not establish authorship of every component.",
    sources: [
      { name: "WordyChain", href: "https://github.com/FlaBBB/WordyChain" },
      {
        name: "OOT-AI-Agent-Practice",
        href: "https://github.com/FlaBBB/OOT-AI-Agent-Practice",
      },
    ],
  },
  {
    capability: "Project-specific web-stack exposure",
    observedEvidence:
      "JMC documents Next.js App Router, TypeScript, PostgreSQL/Prisma, NextAuth.js v5, Tailwind CSS v4, Bun, Docker, Piston-backed code execution, and multiple submission languages.",
    qualification:
      "This is JMC’s documented stack, not a personal proficiency claim; the README says the project was written by AI.",
    sources: [{ name: "JMC", href: "https://github.com/FlaBBB/JMC" }],
  },
  {
    capability: "Agentic SDLC workflow tooling",
    observedEvidence:
      "harness-agentic-sdlc publishes a TypeScript CLI and repository-local governance: a request-to-deploy lifecycle, structured YAML workflows, approval and CI evidence, a Mission Control projection, and machine-readable JSON output.",
    qualification:
      "This describes the project’s documented capabilities, not verified personal authorship, adoption, or production use.",
    sources: [
      {
        name: "harness-agentic-sdlc",
        href: "https://github.com/FlaBBB/harness-agentic-sdlc",
      },
    ],
  },
  {
    capability: "Security-learning archive",
    observedEvidence:
      "A public cybersecurity archive spans cryptography, digital forensics, reverse engineering, binary exploitation, and smart-contract security, drawn from many CTF platforms and paired with supporting tools and cheatsheets.",
    qualification:
      "A learning archive, not professional security work, a certification, or production security responsibility.",
    sources: [
      {
        name: "Cybers_security",
        href: "https://github.com/FlaBBB/Cybers_security",
      },
    ],
  },
  {
    capability: "Reconciled professional and competition profile",
    observedEvidence:
      "The LinkedIn Source Profile lists an engineering role at Six Zenith Digital, study at Politeknik Negeri Malang, and active Capture The Flag participation; the linked CTFtime profile records competition teams and published writeups since 2023.",
    qualification:
      "Profile-stated and self-reported; not independently verified, and not a claim of seniority, employment terms, or professional security responsibility.",
    sources: [
      { name: "LinkedIn", href: linkedInProfile },
      { name: "CTFtime", href: "https://ctftime.org/user/156246" },
    ],
  },
];

const projects = [
  {
    id: "wordychain",
    index: "01",
    name: "WordyChain",
    deck: "Realtime and web boundaries, kept visible.",
    structureLabel: "Visible WordyChain packages",
    structure: ["web", "realtime", "shared", "dictionary", "game-core"],
    copy: "Public project structure separates realtime, web, shared, dictionary, and game-core packages; unit-flow, end-to-end, and package-level test directories are visible.",
    scopeNote:
      "Repository structure is evidence of visible project organization, not a claim of exclusive authorship.",
    href: "https://github.com/FlaBBB/WordyChain",
  },
  {
    id: "jmc",
    index: "02",
    name: "JMC",
    deck: "A documented web application stack.",
    structureLabel: "Documented JMC stack",
    structure: ["Next.js", "TypeScript", "PostgreSQL", "Prisma", "Docker"],
    copy: "JMC documents a Next.js and TypeScript application with PostgreSQL/Prisma, NextAuth.js, Tailwind CSS, Bun, Docker, and sandboxed multi-language code execution.",
    scopeNote:
      "This describes JMC’s documented stack. It does not assert individual authorship or proficiency; its README says the project was written by AI.",
    href: "https://github.com/FlaBBB/JMC",
  },
  {
    id: "harness",
    index: "03",
    name: "harness-agentic-sdlc",
    deck: "Workflow governance for agent-driven delivery.",
    structureLabel: "Documented harness-agentic-sdlc surface",
    structure: ["TypeScript", "CLI", "YAML workflows", "Mission Control", "JSON output"],
    copy: "A repository-local harness publishes a request-to-deploy lifecycle with structured workflows, approval and CI evidence, a Mission Control projection for multi-feature work, and machine-readable output.",
    scopeNote:
      "This describes the project’s documented capabilities, not verified personal authorship or production adoption.",
    href: "https://github.com/FlaBBB/harness-agentic-sdlc",
  },
];

const sections = [
  { id: "selected-evidence", label: "Work" },
  { id: "technical-profile", label: "Profile" },
  { id: "learning-archive", label: "Archive" },
  { id: "contact-path", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>flab — Fikri Flab</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17131e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="flab — Fikri Flab" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://flab.my.id/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="flab — Fikri Flab" />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://flab.my.id/" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduced = false;
        try {
          reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        } catch (error) {
          reduced = false;
        }
        if (!reduced) root.classList.add("motion");
        window.setTimeout(function () {
          if (!window.__afterHoursMotionReady) root.classList.remove("motion");
        }, 2000);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="flab-logo" href="#identity" aria-label="flab — back to Fikri Flab’s identity">
        <svg viewBox={`0 0 ${FLAB_VIEWBOX.width} ${FLAB_VIEWBOX.height}`} aria-hidden="true">
          <path d={FLAB_PATH} fill="currentColor" fill-rule={FLAB_FILL_RULE} />
        </svg>
      </a>
      <nav aria-label="Portfolio sections">
        <ol>
          {sections.map(({ id, label }) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ol>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <section id="identity" aria-label="Identity">
        <div class="hero-stage">
          <FlabSculpture client:media="(prefers-reduced-motion: no-preference)" />
        </div>
        <div class="hero-intro">
          <h1>Fikri Flab — learning in public.</h1>
          <p class="hero-tagline">Web applications. Realtime systems. Learning in public.</p>
          <p class="hero-note">
            A closer look at the projects, structure, and learning behind my public work —
            reconciled from GitHub and LinkedIn, based in Malang, Indonesia.
          </p>
          <a class="hero-action" href="#selected-evidence">Explore the work <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section id="selected-evidence" aria-labelledby="selected-evidence-heading">
        <div class="work-layout">
          <div class="work-intro">
            <p class="eyebrow">01 / Work</p>
            <h2 id="selected-evidence-heading" data-reveal>Look inside the work.</h2>
            <p class="section-intro" data-reveal>
              Three public repositories. Different systems, with the source material open to
              inspection.
            </p>
          </div>
          <ol class="work-index">
            {projects.map((project) => (
              <li data-reveal>
                <article aria-labelledby={`${project.id}-heading`}>
                  <p class="project-index" aria-hidden="true">{project.index}</p>
                  <div class="project-body">
                    <h3 id={`${project.id}-heading`}>{project.name}</h3>
                    <p class="project-deck">{project.deck}</p>
                    <div class="project-structure" aria-label={project.structureLabel}>
                      {project.structure.map((item) => <span>{item}</span>)}
                    </div>
                    <p class="project-copy">{project.copy}</p>
                    <p class="scope-note">{project.scopeNote}</p>
                    <a class="project-link" href={project.href}>Source: {project.name} <span aria-hidden="true">↗</span></a>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="technical-profile" aria-labelledby="technical-profile-heading">
        <div class="section-heading">
          <p class="eyebrow">02 / Profile</p>
          <h2 id="technical-profile-heading" data-reveal>Evidence over claims.</h2>
          <p class="section-intro" data-reveal>
            A curated record of publicly visible projects and learning material. Open a record
            for the evidence and its limits.
          </p>
        </div>
        <EvidenceLedger records={profileRecords} />
      </section>

      <section id="learning-archive" aria-labelledby="learning-archive-heading">
        <div class="section-heading">
          <p class="eyebrow">03 / Archive</p>
          <h2 id="learning-archive-heading" data-reveal>Still learning. Keeping the notes.</h2>
        </div>
        <div class="archive-copy">
          <p data-reveal>
            A public CTF-oriented archive spans cryptography, digital forensics, reverse
            engineering, binary exploitation, and smart-contract security across many
            competition platforms, with supporting tools and cheatsheets.
          </p>
          <p class="scope-note" data-reveal>Learning material, not professional security experience.</p>
          <div class="archive-links">
            <a class="text-link" href="https://github.com/FlaBBB/Cybers_security" data-reveal>
              Inspect Cybers_security <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="https://ctftime.org/user/156246" data-reveal>
              Competition record on CTFtime <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section id="contact-path" aria-labelledby="contact-path-heading">
        <div class="contact-layout">
          <div class="contact-intro-block">
            <p class="eyebrow">04 / Contact</p>
            <h2 id="contact-path-heading" data-reveal>Let’s talk.</h2>
            <p class="contact-intro" data-reveal>
              Explore the source, connect on LinkedIn, or send a note directly.
            </p>
          </div>
          <ul class="contact-paths">
            <li data-reveal>
              <a href={githubProfile}>
                <span class="contact-label"><strong>GitHub</strong><span>Inspect public work</span></span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li data-reveal>
              <a href={linkedInProfile}>
                <span class="contact-label"><strong>LinkedIn</strong><span>Professional profile</span></span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li data-reveal>
              <!--email_off--><a href={`mailto:${email}`}>
                <span class="contact-label"><strong>Email</strong><span>Start a conversation</span></span>
                <span aria-hidden="true">↗</span>
              </a><!--/email_off-->
            </li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>Fikri Flab / flab</span>
      <a href="#identity">Back to top ↑</a>
    </footer>

    <style is:global>
      :root {
        --background: #17131e;
        --surface: #1f1929;
        --ink: #ece8f4;
        --muted-ink: #a89fb8;
        --rule: #2f2839;
        --accent: #a78bfa;
        --accent-strong: #7c5cf5;
        --accent-ink: #d9cffb;
        /* Open contact band: light violet surface with plum ink (6.7:1). */
        --contact-band: #a78bfa;
        --contact-ink: #1b1430;
        --gutter: clamp(1.25rem, 5vw, 5rem);
        --font-sans:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue",
          Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        color-scheme: dark;
        font-family: var(--font-sans);
        font-synthesis: none;
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: var(--background);
        scroll-behavior: smooth;
        scroll-padding-top: 6rem;
      }
      body {
        margin: 0;
        background: var(--background);
        color: var(--ink);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3,
      p,
      ol,
      ul,
      dl,
      dd {
        margin: 0;
      }
      a {
        color: inherit;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25em;
      }
      a,
      summary {
        -webkit-tap-highlight-color: transparent;
      }
      a:focus-visible,
      summary:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }
      /* The contact band is violet, so the default accent outline would be
         invisible on it; use the band's own ink for a contrasting ring. */
      #contact-path a:focus-visible {
        outline-color: var(--contact-ink);
      }
      main:focus {
        outline: none;
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: var(--gutter);
        z-index: 20;
        padding: 0.75rem 1rem;
        color: var(--background);
        background: var(--accent);
        border-radius: 999px;
        transform: translateY(-200%);
      }
      .skip-link:focus {
        transform: translateY(0);
      }
      .eyebrow {
        color: var(--muted-ink);
        font: 500 0.75rem/1.5 var(--font-mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.1rem var(--gutter);
        background: color-mix(in srgb, var(--background) 88%, transparent);
        backdrop-filter: blur(10px);
      }
      .flab-logo {
        display: inline-flex;
        align-items: center;
        color: var(--ink);
        flex-shrink: 0;
        transition: color 180ms ease;
      }
      .flab-logo:hover {
        color: var(--accent-ink);
      }
      .flab-logo svg {
        width: 3.75rem;
        height: auto;
        display: block;
      }
      nav {
        min-width: 0;
      }
      nav ol {
        display: flex;
        align-items: center;
        gap: clamp(0.75rem, 2vw, 2rem);
        padding: 0;
        list-style: none;
      }
      nav a {
        display: inline-flex;
        align-items: center;
        min-height: 2.8125rem;
        white-space: nowrap;
        color: var(--muted-ink);
        font-size: 0.9375rem;
        text-decoration: none;
        transition: color 180ms ease;
      }
      nav a:hover {
        color: var(--ink);
      }

      section {
        padding: 4.5rem var(--gutter);
      }
      .section-heading {
        display: grid;
        gap: 0.75rem;
        max-width: 46rem;
        margin-bottom: 3rem;
      }
      h2 {
        font-size: clamp(2rem, 4.2vw, 3.5rem);
        font-weight: 600;
        line-height: 1.04;
        letter-spacing: -0.04em;
      }
      .section-intro {
        max-width: 48ch;
        color: var(--muted-ink);
      }

      /* Hero */
      #identity {
        padding-top: 1rem;
        padding-bottom: 3rem;
      }
      .hero-stage {
        width: 100%;
        min-height: clamp(20rem, 52vh, 34rem);
      }
      .hero-intro {
        max-width: 52rem;
        margin-inline: auto;
        text-align: center;
        display: grid;
        gap: 1rem;
        justify-items: center;
      }
      h1 {
        font-size: clamp(2.25rem, 5.6vw, 4.75rem);
        font-weight: 600;
        line-height: 1.02;
        letter-spacing: -0.045em;
        text-wrap: balance;
      }
      .hero-tagline {
        font-size: clamp(1.125rem, 2vw, 1.5rem);
        letter-spacing: -0.02em;
      }
      .hero-note {
        max-width: 44ch;
        color: var(--muted-ink);
        font-size: 0.9375rem;
      }
      .hero-action {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        min-height: 3rem;
        margin-top: 0.5rem;
        padding: 0.5rem 1.5rem;
        border-radius: 999px;
        background: var(--accent);
        color: #1b1430;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition:
          background-color 180ms ease,
          transform 180ms ease;
      }
      .hero-action:hover {
        background: var(--accent-ink);
        transform: translateY(-1px);
      }

      /* Work index: narrow editorial intro beside stacked projects. */
      .work-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
        gap: 2.5rem 4rem;
        align-items: start;
      }
      .work-intro {
        position: sticky;
        top: 6.5rem;
        display: grid;
        gap: 0.85rem;
      }
      .work-intro .section-intro {
        max-width: 30ch;
      }
      .work-index {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 0;
      }
      .work-index > li {
        border-top: 1px solid var(--rule);
      }
      .work-index article {
        display: grid;
        grid-template-columns: 3.5rem 1fr;
        gap: 1rem 1.5rem;
        padding: 2.25rem 0;
      }
      .project-index {
        color: var(--muted-ink);
        font: 500 0.875rem/1.6 var(--font-mono);
      }
      .project-body {
        display: grid;
        gap: 1rem;
        min-width: 0;
      }
      .project-body h3 {
        font-size: clamp(1.75rem, 3.6vw, 2.75rem);
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -0.035em;
        overflow-wrap: anywhere;
      }
      .project-deck {
        color: var(--ink);
        font-size: 1.0625rem;
      }
      .project-structure {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .project-structure span {
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--rule);
        border-radius: 999px;
        color: var(--muted-ink);
        font: 0.75rem/1.4 var(--font-mono);
      }
      .project-copy {
        max-width: 62ch;
        color: var(--muted-ink);
      }
      .scope-note {
        max-width: 62ch;
        padding-left: 1rem;
        border-left: 2px solid var(--rule);
        color: var(--muted-ink);
        font-size: 0.875rem;
      }
      .project-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.8125rem;
        color: var(--accent-ink);
        justify-self: start;
      }
      .project-link:hover {
        text-decoration: underline;
      }

      /* Evidence ledger */
      .evidence-ledger {
        list-style: none;
        padding: 0;
      }
      .evidence-ledger > li {
        border-top: 1px solid var(--rule);
        padding-bottom: 0.5rem;
      }
      .ledger-disclosure {
        display: grid;
        grid-template-columns: 2.5rem 1fr auto;
        gap: 1rem;
        align-items: center;
        min-height: 4.5rem;
        padding: 1.25rem 0 0.75rem;
        cursor: pointer;
        list-style: none;
      }
      .ledger-disclosure::-webkit-details-marker {
        display: none;
      }
      .ledger-number {
        color: var(--muted-ink);
        font: 0.75rem/1.5 var(--font-mono);
      }
      .ledger-capability {
        font-size: clamp(1.125rem, 1.8vw, 1.4rem);
        letter-spacing: -0.02em;
        line-height: 1.3;
      }
      .ledger-disclosure:hover .ledger-capability {
        color: var(--accent-ink);
      }
      .ledger-indicator {
        width: 2rem;
        height: 2rem;
        display: grid;
        place-items: center;
        border: 1px solid var(--rule);
        border-radius: 999px;
        color: var(--accent-ink);
        font: 1.25rem/1 var(--font-mono);
      }
      details[open] .ledger-indicator::before {
        content: "−";
      }
      details:not([open]) .ledger-indicator::before {
        content: "+";
      }
      .ledger-details {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: 2rem 3rem;
        padding: 0.5rem 3rem 1.5rem 3.5rem;
      }
      .ledger-field {
        display: grid;
        align-content: start;
        gap: 0.5rem;
      }
      dt {
        color: var(--muted-ink);
        font: 500 0.6875rem/1.5 var(--font-mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      dd {
        font-size: 0.9375rem;
        overflow-wrap: anywhere;
      }
      .ledger-qualification dd {
        color: var(--muted-ink);
      }
      .ledger-source {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.25rem;
        padding-left: 3.5rem;
      }
      .ledger-source-label {
        color: var(--muted-ink);
        font: 0.6875rem/1.5 var(--font-mono);
        text-transform: uppercase;
      }
      .ledger-source a {
        display: inline-flex;
        align-items: center;
        min-height: 2.8125rem;
        color: var(--accent-ink);
        font-size: 0.875rem;
      }

      /* Archive */
      .archive-copy {
        display: grid;
        gap: 1.25rem;
        max-width: 60ch;
        color: var(--muted-ink);
      }
      .archive-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
      }
      .text-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.8125rem;
        color: var(--accent-ink);
      }
      .text-link:hover {
        text-decoration: underline;
      }

      /* Contact: open violet band with plum ink and adjacent paths. */
      #contact-path {
        background: var(--contact-band);
        color: var(--contact-ink);
        border-radius: 1.5rem 1.5rem 0 0;
        margin-top: 2rem;
      }
      .contact-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: 2.5rem 4rem;
        align-items: start;
      }
      #contact-path .eyebrow {
        color: color-mix(in srgb, var(--contact-ink) 78%, transparent);
      }
      #contact-path h2 {
        margin-top: 0.75rem;
      }
      .contact-intro {
        margin-top: 1rem;
        max-width: 38ch;
        color: color-mix(in srgb, var(--contact-ink) 82%, transparent);
      }
      .contact-paths {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
        padding: 0;
        list-style: none;
      }
      .contact-paths li {
        border-top: 2px solid color-mix(in srgb, var(--contact-ink) 32%, transparent);
      }
      .contact-paths a {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
        min-height: 5.5rem;
        padding-top: 1rem;
        text-decoration: none;
      }
      .contact-label {
        display: grid;
        gap: 0.2rem;
      }
      .contact-paths strong {
        font-size: 1.25rem;
        font-weight: 600;
      }
      .contact-label > span {
        color: color-mix(in srgb, var(--contact-ink) 82%, transparent);
        font-size: 0.875rem;
      }
      .contact-paths a > span:last-child {
        align-self: flex-end;
        font-size: 1.25rem;
      }
      .contact-paths a:hover strong {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      /* Footer */
      .site-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem 2rem;
        padding: 1.5rem var(--gutter);
        color: var(--muted-ink);
        font-size: 0.8125rem;
      }
      .site-footer a {
        display: inline-flex;
        align-items: center;
        min-height: 2.8125rem;
      }

      @media (min-width: 1700px) {
        body {
          max-width: 108rem;
          margin-inline: auto;
        }
      }
      @media (max-width: 900px) {
        .work-layout,
        .contact-layout {
          grid-template-columns: 1fr;
        }
        .work-intro {
          position: static;
        }
        .work-intro .section-intro {
          max-width: 48ch;
        }
        .ledger-details {
          grid-template-columns: 1fr;
        }
        .ledger-details {
          gap: 1.5rem;
          padding-right: 0;
        }
      }
      @media (max-width: 640px) {
        .site-header {
          padding-inline: var(--gutter);
        }
        section {
          padding-block: 3.25rem;
        }
        .flab-logo svg {
          width: 3rem;
        }
        nav ol {
          gap: 0.9rem;
        }
        nav a {
          font-size: 0.875rem;
        }
        .ledger-disclosure {
          grid-template-columns: 1.5rem 1fr auto;
          gap: 0.75rem;
        }
        .ledger-details,
        .ledger-source {
          padding-left: 2.25rem;
        }
        .work-index article {
          grid-template-columns: 2.25rem 1fr;
          gap: 0.5rem 1rem;
        }
        .contact-paths {
          grid-template-columns: 1fr;
          gap: 0;
        }
        .contact-paths a {
          flex-direction: row;
          align-items: center;
          min-height: 4.5rem;
        }
        .contact-paths a > span:last-child {
          align-self: center;
        }
        #contact-path {
          border-radius: 1.25rem 1.25rem 0 0;
        }
      }

      .motion [data-reveal] {
        opacity: 0;
        transform: translateY(1.25rem);
      }
      @media (prefers-reduced-motion: no-preference) {
        nav a,
        .flab-logo,
        .hero-action,
        .project-link,
        .text-link,
        .ledger-source a,
        #contact-path a,
        .site-footer a {
          transition:
            color 180ms ease,
            background-color 180ms ease,
            border-color 180ms ease,
            transform 180ms ease;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>

    <script>
      import gsap from "gsap";

      declare global {
        interface Window {
          __afterHoursMotionReady?: boolean;
        }
      }

      const root = document.documentElement;
      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealTargets = gsap.utils.toArray<HTMLElement>("[data-reveal]");
      const nudgeLinks = gsap.utils.toArray<HTMLElement>(
        ".hero-action, .project-link, .text-link, .ledger-source a, .site-footer a, #contact-path a",
      );
      // The nudge animates the trailing arrow when a link has one, so the arrow
      // is what must be cleaned up when motion is switched off.
      const nudgeTargets = nudgeLinks.map(
        (element) =>
          element.querySelector<HTMLElement>('span[aria-hidden="true"]') ?? element,
      );

      let active = false;
      let revealObserver: IntersectionObserver | undefined;
      let focusInHandler: ((event: Event) => void) | undefined;
      let scrollHandler: (() => void) | undefined;
      let scrollFrame = 0;

      function settle(targets: HTMLElement[]) {
        // Cancel any in-flight reveal first: otherwise a running opacity/y tween
        // repaints its earlier pose on the next frame, undoing this settlement.
        gsap.killTweensOf(targets, "opacity,y");
        gsap.set(targets, { opacity: 1, y: 0 });
      }

      function stopMotion() {
        revealObserver?.disconnect();
        revealObserver = undefined;
        if (focusInHandler) document.removeEventListener("focusin", focusInHandler);
        if (scrollHandler) {
          window.removeEventListener("scroll", scrollHandler);
          window.removeEventListener("hashchange", scrollHandler);
        }
        if (scrollFrame) cancelAnimationFrame(scrollFrame);
        focusInHandler = undefined;
        scrollHandler = undefined;
        scrollFrame = 0;
        gsap.killTweensOf([...revealTargets, ...nudgeTargets]);
        gsap.set(nudgeTargets, { clearProps: "transform" });
        root.classList.remove("motion");
        gsap.set(revealTargets, { clearProps: "all" });
        active = false;
      }

      function startMotion() {
        if (active) return;
        active = true;
        root.classList.add("motion");

        if (revealTargets.length) {
          revealObserver = new IntersectionObserver(
            (entries) => {
              const entering = entries
                .filter((entry) => entry.isIntersecting)
                .map((entry) => entry.target as HTMLElement);
              for (const target of entering) revealObserver?.unobserve(target);
              if (!entering.length) return;
              gsap.killTweensOf(entering, "opacity,y");
              gsap.to(entering, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                stagger: 0.06,
              });
            },
            { rootMargin: "0px 0px -10% 0px" },
          );
          for (const target of revealTargets) revealObserver.observe(target);
        }

        focusInHandler = (event) => {
          const node = event.target;
          if (!(node instanceof Element)) return;
          const target = node.closest<HTMLElement>("[data-reveal]");
          if (target) settle([target]);
        };
        document.addEventListener("focusin", focusInHandler);

        // IntersectionObserver computes intersections on rendering frames, so a
        // fast scroll, an instant jump, or a deep-link landing can pass an
        // element without it ever being reported as intersecting. Anything
        // already scrolled past the viewport is settled here, so no target can
        // stay permanently hidden.
        const settlePassed = () => {
          const passed = revealTargets.filter(
            (target) =>
              Number(getComputedStyle(target).opacity) < 1 &&
              target.getBoundingClientRect().bottom <= 0,
          );
          if (!passed.length) return;
          for (const target of passed) revealObserver?.unobserve(target);
          settle(passed);
        };

        scrollHandler = () => {
          if (scrollFrame) return;
          scrollFrame = requestAnimationFrame(() => {
            scrollFrame = 0;
            settlePassed();
          });
        };
        window.addEventListener("scroll", scrollHandler, { passive: true });
        // A deep link may have scrolled before this module ran, so sweep once.
        requestAnimationFrame(settlePassed);
        window.addEventListener("hashchange", scrollHandler);
      }

      for (const element of nudgeLinks) {
        const arrow = element.querySelector<HTMLElement>('span[aria-hidden="true"]');
        const nudge = (direction: number) => {
          if (!active) return;
          gsap.to(arrow ?? element, {
            x: direction * 4,
            duration: 0.22,
            ease: "power2.out",
            overwrite: "auto",
          });
        };
        element.addEventListener("pointerenter", () => nudge(1));
        element.addEventListener("pointerleave", () => nudge(0));
        element.addEventListener("focus", () => nudge(1));
        element.addEventListener("blur", () => nudge(0));
      }

      function syncMotionPreference() {
        if (motionQuery.matches) {
          if (active) stopMotion();
          return;
        }
        startMotion();
      }

      motionQuery.addEventListener("change", syncMotionPreference);
      syncMotionPreference();
      window.__afterHoursMotionReady = true;
    </script>
  </body>
</html>
