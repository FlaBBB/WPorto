---
/**
 * The shell the page is built in: the document head, the header, and the motion
 * module.
 *
 * The site is one page, so the shell is written once and the page slots its
 * content in.
 */
import { FLAB_PATH, FLAB_FILL_RULE, FLAB_VIEWBOX } from "../lib/flabMark";
import { description, sections } from "../lib/portfolio";
import "../styles/fonts.css";
import "../styles/portfolio.css";

const {
  /** The document title. */
  title,
  /** The meta description; the site description by default. */
  metaDescription = description,
  /** The route this page is served at, for the canonical and og:url. */
  path,
} = Astro.props as {
  title: string;
  metaDescription?: string;
  path: string;
};

const url = `https://flab.my.id${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#17131e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <!--
      The variable sans is the only face above the fold (the wordmark, the opening
      heading), so it is preloaded to avoid a swap on the largest text. Fonts load
      in CORS mode, hence the crossorigin attribute.
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/schibsted-grotesk-var.woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduced = false;
        try {
          reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        } catch (error) {
          reduced = false;
        }
        if (!reduced) root.classList.add("motion");
        window.setTimeout(function () {
          if (!window.__afterHoursMotionReady) root.classList.remove("motion");
        }, 2000);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="flab-logo" href="#identity" aria-label="flab — back to the top">
        <svg viewBox={`0 0 ${FLAB_VIEWBOX.width} ${FLAB_VIEWBOX.height}`} aria-hidden="true">
          <path d={FLAB_PATH} fill="currentColor" fill-rule={FLAB_FILL_RULE} />
        </svg>
      </a>
      {/*
        The four sections are one page now, so these are anchors rather than routes:
        they are a shortcut past the opening to a section the visitor has already
        decided they want, not the only way to reach it.
      */}
      <nav class="site-nav" aria-label="Portfolio sections">
        <ul>
          {sections.map(({ id, label }) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <script>
      import { initPageMotion } from "../lib/pageMotion";

      initPageMotion();

      /*
        The header is transparent over the opening, so the star field reads through
        it with no container edge over the sky. Once the opening has scrolled away
        it sits over content instead, where an unbacked bar would leave the wordmark
        and the section links floating over body text.
      */
      const header = document.querySelector(".site-header");
      const opening = document.getElementById("identity");
      if (header && opening) {
        const observer = new IntersectionObserver(
          (entries) => {
            const [entry] = entries;
            if (!entry) return;
            header.toggleAttribute("data-scrolled", !entry.isIntersecting);
          },
          { threshold: 0 },
        );
        observer.observe(opening);
      }
    </script>
  </body>
</html>
