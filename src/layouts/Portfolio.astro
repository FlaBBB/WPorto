---
/**
 * The shell the page is built in: the document head, the header, the footer, and
 * the motion module.
 *
 * The site is one page, so the shell is written once and the page slots its
 * content in.
 */
import LoadingScreen from "../components/LoadingScreen.astro";
import SparseStars from "../components/SparseStars.svelte";
import { FLAB_PATH, FLAB_FILL_RULE, FLAB_VIEWBOX } from "../lib/flabMark";
import { description, ownerName, sections } from "../lib/portfolio";
import "../styles/fonts.css";
import "../styles/portfolio.css";

const {
  /** The document title. */
  title,
  /** The meta description; the site description by default. */
  metaDescription = description,
  /** The route this page is served at, for the canonical and og:url. */
  path,
  /**
   * `home` is the one-page Portfolio Site with its opening and scroll scene.
   * `document` is a writing page: the same shell and section links, but no
   * opening and no page-level scroll reservation.
   */
  variant = "home",
  /** Open Graph type; a Writing note is an article, everything else a website. */
  ogType = "website",
} = Astro.props as {
  title: string;
  metaDescription?: string;
  path: string;
  variant?: "home" | "document";
  ogType?: "website" | "article";
};

const isHome = variant === "home";
const writingCurrent = path === "/writing" || path.startsWith("/writing/");
const navItems = sections.map(({ id, label }) => ({
  id,
  label,
  // On the home page the links are anchors to its sections. Everywhere else
  // they return to those anchors, except Writing, which has a page of its own.
  href: isHome ? `#${id}` : id === "writing" ? "/writing" : `/#${id}`,
  current: !isHome && id === "writing" && writingCurrent,
}));

const url = `https://flab.my.id${path}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#17131e" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <!--
      The variable sans is the only face above the fold (the wordmark, the opening
      heading), so it is preloaded to avoid a swap on the largest text. Fonts load
      in CORS mode, hence the crossorigin attribute.
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/schibsted-grotesk-var.woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduced = false;
        try {
          reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        } catch (error) {
          reduced = false;
        }
        if (!reduced) root.classList.add("motion");
        window.setTimeout(function () {
          if (!window.__afterHoursMotionReady) root.classList.remove("motion");
        }, 2000);
      })();
    </script>
  </head>
  <body>
    {isHome && <LoadingScreen />}

    <header class="site-header">
      <a
        class="flab-logo"
        href={isHome ? "#identity" : "/"}
        aria-label={isHome ? "flab — back to the top" : "flab — back to the Portfolio Site"}
      >
        <svg viewBox={`0 0 ${FLAB_VIEWBOX.width} ${FLAB_VIEWBOX.height}`} aria-hidden="true">
          <path d={FLAB_PATH} fill="currentColor" fill-rule={FLAB_FILL_RULE} />
        </svg>
      </a>
      {/*
        The sections are one page now, so these are anchors rather than routes:
        they are a shortcut past the opening to a section the visitor has already
        decided they want, not the only way to reach it. On a writing page they
        return to the home page's anchors, and Writing points at its own index.
      */}
      <nav class="site-nav" aria-label="Portfolio sections">
        <ul>
          {navItems.map(({ label, href, current }) => (
            <li>
              <a href={href} aria-current={current ? "page" : undefined}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <SparseStars seed={6} client:load />
      <div class="footer-inner">
        <p class="footer-identity">
          <span class="footer-name">{ownerName}</span>
          <span class="footer-sep" aria-hidden="true">·</span>
          <span class="footer-copy">© {year}</span>
        </p>
        <!--
          The right group is the link back to the opening itself, so there is no
          third visible "Back to top" group. Its accessible name keeps the visible
          "Still learning." label (Label in Name) while naming the destination.
          On a document page the destination is the Portfolio Site's opening.
        -->
        <a
          class="footer-top"
          href={isHome ? "#identity" : "/"}
          aria-label={isHome ? "Back to the opening — Still learning." : "Back to the Portfolio Site — Still learning."}
          title={isHome ? "Back to the opening" : "Back to the Portfolio Site"}
        >
          <span class="footer-note">Still learning.</span>
          <span class="footer-dash" aria-hidden="true"></span>
        </a>
      </div>
    </footer>

    <script>
      import { initPageMotion } from "../lib/pageMotion";

      initPageMotion();
      /*
        The header is transparent over the opening, so the star field reads through
        it with no container edge over the sky. Once the opening has scrolled away
        it sits over content instead, where an unbacked bar would leave the wordmark
        and the section links floating over body text.
      */
      const header = document.querySelector(".site-header");
      const opening = document.getElementById("identity");
      if (header && opening) {
        const observer = new IntersectionObserver(
          (entries) => {
            const [entry] = entries;
            if (!entry) return;
            header.toggleAttribute("data-scrolled", !entry.isIntersecting);
          },
          { threshold: 0 },
        );
        observer.observe(opening);
      }
    </script>
  </body>
</html>
