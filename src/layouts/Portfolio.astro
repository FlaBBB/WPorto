---
/**
 * The shell every page shares: the document head, the fixed wordmark, the
 * section navigation, and the view transition between pages.
 *
 * The site is five pages — the opening at `/` and one page per section — and
 * they differ only in the content they slot in, so the shell lives here once
 * rather than being restated by each page. A view transition moves between them,
 * which is what keeps the moment of a destination click continuous instead of a
 * hard document swap.
 */
import { ClientRouter } from "astro:transitions";
import { FLAB_PATH, FLAB_FILL_RULE, FLAB_VIEWBOX } from "../lib/flabMark";
import { description, sections } from "../lib/portfolio";
import "../styles/fonts.css";
import "../styles/portfolio.css";

const {
  /** The document title, which the section pages name themselves in. */
  title,
  /** The meta description; the site description by default. */
  metaDescription = description,
  /** The route this page is served at, for the canonical and og:url. */
  path,
} = Astro.props as {
  title: string;
  metaDescription?: string;
  path: string;
};

const url = `https://flab.my.id${path}`;

/**
 * The section this page serves, if it serves one.
 *
 * The opening serves none, so it carries no section navigation: there the map
 * *is* the navigation, and a bar of links would compete with the stars it exists
 * to reveal. A section page carries the four links, because a visitor who landed
 * on one has no map in front of them.
 */
const current = sections.find((section) => section.href === path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#17131e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    {/*
      Moves between the five pages without a hard document swap, so the moment a
      destination is chosen can stay continuous. See `src/lib/pageMotion.ts` for
      what has to be re-wired per page once navigation no longer reloads the
      document.
    */}
    <ClientRouter />
    <!--
      The variable sans is the only face above the fold (the wordmark, the opening
      heading), so it is preloaded to avoid a swap on the largest text. Fonts load
      in CORS mode, hence the crossorigin attribute.
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/schibsted-grotesk-var.woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduced = false;
        try {
          reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        } catch (error) {
          reduced = false;
        }
        if (!reduced) root.classList.add("motion");
        window.setTimeout(function () {
          if (!window.__afterHoursMotionReady) root.classList.remove("motion");
        }, 2000);
      })();
    </script>
  </head>
  <body>
    <header class="site-header" data-nav={current ? "sections" : undefined}>
      <a class="flab-logo" href="/" aria-label="flab — back to the opening">
        <svg viewBox={`0 0 ${FLAB_VIEWBOX.width} ${FLAB_VIEWBOX.height}`} aria-hidden="true">
          <path d={FLAB_PATH} fill="currentColor" fill-rule={FLAB_FILL_RULE} />
        </svg>
      </a>
      {/*
        The map is the opening's navigation and this is the section pages'. Each
        page carries one route to every section, so a visitor who arrived on a
        section page is never stranded there.
      */}
      {current && (
        <nav class="site-nav" aria-label="Portfolio sections">
          <ul>
            {sections.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={href === path ? "page" : undefined}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <script>
      import { holdIncomingReveals, initPageMotion } from "../lib/pageMotion";

      // The reveals of the page being navigated to are held before it paints, so
      // the entrance is the reveal rather than a flash of settled content.
      document.addEventListener("astro:before-swap", holdIncomingReveals);
      initPageMotion();
    </script>
  </body>
</html>
